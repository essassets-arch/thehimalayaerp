# ==============================================================================
# HIMALAYA ERP — LOCAL DEVELOPMENT ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================

NODE_ENV=development

# Database Settings
POSTGRES_DB=himalaya_erp_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/himalaya_erp_dev?schema=public

# Server Ports
PORT=4000
BACKEND_PORT=4000
FRONTEND_PORT=3000

# Backend Configuration
API_PREFIX=api/v1
BACKEND_API_PREFIX=api/v1
BACKEND_INTERNAL_URL=http://127.0.0.1:4000/api/v1
BACKEND_API_URL=http://127.0.0.1:4000/api/v1

# Public Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Authentication & JWT (Change in production!)
JWT_ACCESS_SECRET=local_dev_jwt_secret_key_change_in_production_123456789
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=local_dev_refresh_secret_key_change_in_production_987654321
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# File Upload Directory
UPLOAD_DIR=./uploads

# Security Controls
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
TRUST_PROXY=false

# Initial Admin Credentials for Seeding
INITIAL_ADMIN_EMAIL=admin@himalaya.com
INITIAL_ADMIN_PASSWORD=Admin@123456

# Management Tooling Credentials
PGADMIN_DEFAULT_EMAIL=admin@himalaya.com
PGADMIN_DEFAULT_PASSWORD=AdminPgPassword123!
DOZZLE_USERNAME=admin
DOZZLE_PASSWORD=AdminLogsPass123!

# Firebase Configuration
# Backend Credentials (ordered by resolution)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=himalaya-c9d06
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

