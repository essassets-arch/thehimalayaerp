# ==============================================================================
# HIMALAYA ERP — PRODUCTION CADDY REVERSE PROXY & MANAGEMENT SUBDOMAINS
# ==============================================================================

# ── 1. Primary ERP Application ────────────────────────────────────────────────
{$APP_DOMAIN:thehimalaya.cloud} {
    encode gzip zstd

    request_body {
        max_size 100MB
    }

    # Security Headers
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        X-XSS-Protection "1; mode=block"
        Referrer-Policy "strict-origin-when-cross-origin"
    }

    @socket_io {
        path /socket.io*
    }
    reverse_proxy @socket_io backend:4000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }

    reverse_proxy frontend:3000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# ── 2. pgAdmin 4 Database Administration UI ───────────────────────────────────
dbadmin.{$APP_DOMAIN:thehimalaya.cloud} {
    encode gzip zstd

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }

    reverse_proxy pgadmin:80 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Script-Name /
    }
}

# ── 3. Portainer CE Container Management UI ──────────────────────────────────
portainer.{$APP_DOMAIN:thehimalaya.cloud} {
    encode gzip zstd

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }

    reverse_proxy portainer:9000 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}

# ── 4. Dozzle Real-time Docker Log Viewer ─────────────────────────────────────
logs.{$APP_DOMAIN:thehimalaya.cloud} {
    encode gzip zstd

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
    }

    reverse_proxy dozzle:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}
    }
}
