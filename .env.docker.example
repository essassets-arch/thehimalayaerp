# ==============================================================================
# HIMALAYA ERP — PRODUCTION VPS DOCKER ENVIRONMENT TEMPLATE (.env.docker.example)
# Copy this file to .env on your VPS and update all secrets before deploying.
# ==============================================================================

NODE_ENV=production

# Database Credentials & Connection
POSTGRES_DB=himalaya_erp
POSTGRES_USER=himalaya_erp_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD

# PostgreSQL URL using internal Docker container hostname "postgres"
DATABASE_URL=postgresql://himalaya_erp_user:CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD@postgres:5432/himalaya_erp?schema=public&connection_limit=5&pool_timeout=20
# Migrations run as a one-off container, so keep them to a single connection.
MIGRATION_DATABASE_URL=postgresql://himalaya_erp_user:CHANGE_ME_TO_A_STRONG_RANDOM_PASSWORD@postgres:5432/himalaya_erp?schema=public&connection_limit=1&pool_timeout=30
DATABASE_CONNECTION_LIMIT=5
DATABASE_POOL_TIMEOUT=20

# API Prefix & Server Port
API_PREFIX=api/v1
BACKEND_PORT=4000
FRONTEND_PORT=3000

# Internal Docker Communication URL (Frontend API bridge -> NestJS Container)
BACKEND_INTERNAL_URL=http://backend:4000/api/v1
BACKEND_API_URL=http://backend:4000/api/v1

# VPS Domain & Public Application URLs
NEXT_PUBLIC_APP_URL=https://thehimalaya.cloud
FRONTEND_URL=https://thehimalaya.cloud
APP_URL=https://thehimalaya.cloud
CORS_ORIGIN=https://thehimalaya.cloud

# Authentication & JWT Secrets (MUST be long, secure random strings!)
JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Cookies & Proxy Security
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
TRUST_PROXY=true

# Persistent File Upload Directory
UPLOAD_DIR=/app/uploads

# Initial System Admin Setup Credentials
INITIAL_ADMIN_EMAIL=admin@himalaya.com
INITIAL_ADMIN_PASSWORD=CHANGE_ME_ADMIN_INITIAL_PASSWORD

# Rate Limiting & Health
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# Production Management & Observability Tooling Credentials
PGADMIN_DEFAULT_EMAIL=admin@thehimalaya.cloud
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_STRONG_PGADMIN_PASSWORD_123!
DOZZLE_USERNAME=admin
DOZZLE_PASSWORD=CHANGE_ME_DOZZLE_PASSWORD_123!

# ==============================================================================
# OPTIONAL INTEGRATIONS & WEB CLIENT CONFIGURATIONS
# ==============================================================================

# Firebase Client SDK Configuration (Optional - for FCM Push Notifications)
# NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy...
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=himalaya-c9d06.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=himalaya-c9d06
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=himalaya-c9d06.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=478469947785
# NEXT_PUBLIC_FIREBASE_APP_ID=1:478469947785:web:bb56793c56cd6e91b7e158
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-VSNCPJ95SJ
# NEXT_PUBLIC_FIREBASE_VAPID_KEY=BHQC5Wf2yNHjsOGWK...

# Google Maps API Configuration (Optional)
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSy...

# WebSocket Server URL (Optional - defaults to relative URL/same-origin if not set)
# NEXT_PUBLIC_SOCKET_URL=wss://thehimalaya.cloud
