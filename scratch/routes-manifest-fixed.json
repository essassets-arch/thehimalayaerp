    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    },
    {
      "source": "/super-admin/finished-goods",
      "destination": "/super-admin/dashboard",
      "statusCode": 307,
      "regex": "^(?!/_next)/super-admin/finished-goods(?:/)?$"
    },
    {
      "source": "/plant-head/finished-goods",
      "destination": "/plant-head/dashboard",
      "statusCode": 307,
      "regex": "^(?!/_next)/plant-head/finished-goods(?:/)?$"
    }
  ],
  "headers": [
    {
      "source": "/firebase-messaging-sw.js",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/javascript"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ],
      "regex": "^/firebase-messaging-sw\\.js(?:/)?$"
    }
  ],
