model Dispatch {
  id           String         @id @default(uuid())
  dispatchNo   String         @unique
  salesOrderId String
  status       DispatchStatus @default(DISPATCH_DRAFT)
  isSubmitted  Boolean        @default(false)

  // Delivery info
  deliveryAddress     String?
  specialInstructions String?

  // Packages
  packageCount Int?
  packageType  String? // e.g. Box, Pallet, Bag
  totalWeight  Decimal? @db.Decimal(18, 3)

  // Transport / Vehicle
  transporterName String?
  vehicleNumber   String?
  vehicleType     String?
  driverName      String?
  driverPhone     String?
  driverLicence   String?
  lrNumber        String? // LR / Consignment Number
  freightType     String? // e.g. Paid, To Pay, contract
  freightAmount   Decimal? @db.Decimal(18, 2)
  trackingRef     String? // GPS / tracking reference

  // 3. Approval details
  approvedAt       DateTime?
  approvedById     String?
  rejectionRemarks String?

  // 4. Ready for Pickup
  readyAt           DateTime?
  readyById         String?
  dispatchLocation  String?
  documentChecklist Json? // checklist state e.g. { packed: true, labels: true, invoice: true }

  // 5 & 6. Loading
  loadingStartedAt   DateTime?
  loadingCompletedAt DateTime?
  loadedQuantity     Decimal?  @db.Decimal(18, 3)
  vehicleClean       Boolean?  @default(true)
  sealNumber         String?
  loadingSupervisor  String?
  loadingRemarks     String? // shortage or damage comments

  // 7. Gate Out / Dispatched
  dispatchedAt          DateTime?
  dispatchedById        String?
  gateOutAt             DateTime?
  gatePassNumber        String?
  gateSecurityConfirmed Boolean?  @default(false)
  invoiceNumber         String?
  ewayBillNumber        String?

  // 8. In Transit
  currentLocation      String?
  lastLocationUpdateAt DateTime?
  eta                  DateTime?
  transitCondition     String? // ON_SCHEDULE, DELAYED, BREAKDOWN, ROUTE_CHANGED, FAILED
  transitRemarks       String?
  transitLogs          Json? // Location / status history log

  // 9. Out for Delivery
  outForDeliveryAt      DateTime?
  deliveryContactPerson String?
  deliveryContactPhone  String?
  expectedDeliveryTime  DateTime?
  deliveryAttemptNo     Int?      @default(1)

  // 10 & 11. Delivery & POD
  deliveredAt         DateTime?
  deliveredQuantity   Decimal?  @db.Decimal(18, 3)
  shortQuantity       Decimal?  @db.Decimal(18, 3)
  damagedQuantity     Decimal?  @db.Decimal(18, 3)
  receivedBy          String?
  receiverDesignation String?
  receiverPhone       String?
  deliveryRemarks     String?
  deliveryPhotoUrl    String?
  signatureUrl        String?
  podUrl              String?
  podReceivedAt       DateTime?
  podApprovedAt       DateTime?
  podApprovedById     String?
  podStatus           String? // PENDING, APPROVED, REJECTED

  // 12. Closure
  closedAt        DateTime?
  closedById      String?
  transitDuration Int? // transit duration in hours / minutes

  workflowStateId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  salesOrder    SalesOrder     @relation(fields: [salesOrderId], references: [id])
  items         DispatchItem[]
  invoices      SalesInvoice[]
  workflowState WorkflowState? @relation("DispatchWorkflow", fields: [workflowStateId], references: [id])

  @@index([workflowStateId])
}

