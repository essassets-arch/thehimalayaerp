  transitions WorkflowTransition[]
}

model WorkflowState {
  id         String             @id @default(uuid())
  workflowId String
  workflow   WorkflowDefinition @relation(fields: [workflowId], references: [id])
  code       String
  name       String
  sequence   Int
  isInitial  Boolean            @default(false)
  isFinal    Boolean            @default(false)

  // Relations to track entities currently in this state
  salesOrders        SalesOrder[]
  SalesReturn        SalesReturn[]
  ReplacementRequest ReplacementRequest[]
  ReplacementOrder   ReplacementOrder[]
  PurchaseOrder      PurchaseOrder[]
  ProductionPlan     ProductionPlan[]     @relation("ProductionPlanWorkflow")
  WorkOrder          WorkOrder[]          @relation("WorkOrderWorkflow")
  QCInspection       QCInspection[]       @relation("QCInspectionWorkflow")
  Dispatch           Dispatch[]           @relation("DispatchWorkflow")
  SalesInvoice       SalesInvoice[]       @relation("InvoiceWorkflow")
  CustomerPayment    CustomerPayment[]    @relation("PaymentWorkflow")
  Lead               Lead[]
  Quotation          Quotation[]
}

model WorkflowTransition {
  id               String             @id @default(uuid())
  workflowId       String
  workflow         WorkflowDefinition @relation(fields: [workflowId], references: [id])
  fromStateId      String
  toStateId        String
  actionName       String
  actionLabel      String
  requiredRole     String?
  requiresApproval Boolean            @default(false)
  allowReject      Boolean            @default(false)
}

model WorkflowHistory {
  id         String   @id @default(uuid())
  companyId  String?
  entityType String // SalesOrder, Quotation, ProductionPlan, Dispatch, Invoice, Return ...
  entityId   String
  fromStatus String
  toStatus   String
  action     String
  remarks    String?
  userId     String
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([companyId])
  @@index([userId])
  @@index([createdAt])
}

// Kept for backward compat — workflowCode maps to entityType
model WorkflowHistoryLegacy {
  id           String   @id @default(uuid())
  workflowCode String
  entityId     String
  entityType   String
  fromState    String
  toState      String
  action       String
  remarks      String?
  userId       String
  createdAt    DateTime @default(now())
}

