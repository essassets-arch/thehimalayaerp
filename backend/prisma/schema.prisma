generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// DocumentSequence: generates human-readable document numbers per type/year.
// Example: SO-2025-000123, QT-2025-000456, INV-2025-000987
model DocumentSequence {
  id            String   @id @default(uuid())
  companyId     String
  documentType  String // SO, QT, WO, INV, DISP, PAY, RET, REPL, SAMP, PROD ...
  prefix        String // SO, QT, etc.
  year          Int
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([companyId, documentType, year])
  @@index([companyId, documentType])
}

// Legacy — kept for backward compat, superseded by DocumentSequence
model IdSequence {
  key       String   @id
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  CREDIT_HOLD
}

model Company {
  id                             String                          @id @default(uuid())
  publicId                       String                          @unique
  name                           String
  version                        Int                             @default(1)
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  createdById                    String?
  updatedById                    String?
  deletedAt                      DateTime?
  branches                       Branch[]
  customers                      Customer[]
  employees                      Employee[]
  inventoryTransactions          InventoryTransaction[]
  leads                          Lead[]
  materialRequests               MaterialRequest[]
  products                       Product[]
  rawMaterials                   RawMaterial[]
  purchaseIndents                PurchaseIndent[]
  suppliers                      Supplier[]
  users                          User[]
  warehouses                     Warehouse[]
  SampleRequest                  SampleRequest[]
  PurchaseOrder                  PurchaseOrder[]
  GoodsReceiptNote               GoodsReceiptNote[]
  VendorReturn                   VendorReturn[]
  SupplierPayable                SupplierPayable[]
  procurementDeliveries          ProcurementDelivery[]
  materialRejections             MaterialRejection[]
  procurementReplacementRequests ProcurementReplacementRequest[]
  recruitmentRequests            RecruitmentRequest[]
  departments                    Department[]
  workLocations                  WorkLocation[]
  leaveRequests                  LeaveRequest[]
  dailyReports                   ProductionDailyReport[]
  notifications                  Notification[]
  fcmDeviceTokens                FcmDeviceToken[]
}

model Branch {
  id               String            @id @default(uuid())
  publicId         String            @unique
  name             String
  companyId        String
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdById      String?
  updatedById      String?
  deletedAt        DateTime?
  company          Company           @relation(fields: [companyId], references: [id])
  customers        Customer[]
  materialRequests MaterialRequest[]
  warehouses       Warehouse[]
}

model Role {
  id              String           @id @default(uuid())
  publicId        String           @unique
  name            String
  code            String           @unique
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?
  updatedById     String?
  deletedAt       DateTime?
  rolePermissions RolePermission[]
  users           User[]
}

model Permission {
  id              String           @id @default(uuid())
  publicId        String           @unique
  name            String
  code            String           @unique
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?
  updatedById     String?
  deletedAt       DateTime?
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model User {
  id                            String                 @id @default(uuid())
  publicId                      String                 @unique
  email                         String                 @unique
  password                      String
  name                          String
  roleId                        String
  companyId                     String
  dispatchCategory              String?
  isActive                      Boolean                @default(true)
  failedLoginAttempts           Int                    @default(0)
  lockedUntil                   DateTime?
  version                       Int                    @default(1)
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt
  createdById                   String?
  updatedById                   String?
  deletedAt                     DateTime?
  employee                      Employee?
  materialRequests              MaterialRequest[]
  purchaseIndents               PurchaseIndent[]
  assignedProductionPlans       ProductionPlan[]       @relation("ProductionPlanAssignee")
  refreshSessions               RefreshSession[]
  elevationSessions             ElevationSession[]
  company                       Company                @relation(fields: [companyId], references: [id])
  role                          Role                   @relation(fields: [roleId], references: [id])
  brandAnalysisRequested        BrandAnalysisRequest[] @relation("BrandAnalysisRequestedBy")
  brandAnalysisApproved         BrandAnalysisRequest[] @relation("BrandAnalysisApprovedBy")
  brandAnalysisRejected         BrandAnalysisRequest[] @relation("BrandAnalysisRejectedBy")
  brandAnalysisFinanceStarted   BrandAnalysisRequest[] @relation("BrandAnalysisFinanceStartedBy")
  brandAnalysisFinanceCompleted BrandAnalysisRequest[] @relation("BrandAnalysisFinanceCompletedBy")
  brandAnalysisHistoryPerformed BrandAnalysisHistory[] @relation("BrandAnalysisHistoryPerformedBy")
  salesTargets                  SalesTarget[]
  machineStatusUpdates          MachineDailyStatus[]   @relation("UserMachineStatusUpdates")
  salesExecutiveLeads           Lead[]                 @relation("SalesExecutiveLeads")
  salesExecutiveQuotations      Quotation[]            @relation("SalesExecutiveQuotations")
  customerComplaints            CustomerComplaint[]    @relation("CustomerComplaintSalesExecutive")
  salesExecutiveOrders          SalesOrder[]           @relation("SalesExecutiveOrders")
  salesExecutiveSamples         SampleRequest[]        @relation("SalesExecutiveSamples")
  dailyReportsCreated           ProductionDailyReport[] @relation("DailyReportCreatedBy")
  dailyReportsApproved          ProductionDailyReport[] @relation("DailyReportApprovedBy")
  notifications                 Notification[]
  fcmDeviceTokens               FcmDeviceToken[]
  attendances                   Attendance[]
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id              String              @id @default(uuid())
  customerCode    String              @unique @default(uuid())
  companyId       String
  version         Int                 @default(1)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  createdById     String?
  updatedById     String?
  deletedAt       DateTime?
  alternatePhone  String?
  billingAddress  Json?
  branchId        String?
  companyName     String
  contactPerson   String?
  creditLimit     Decimal?            @db.Decimal(14, 2)
  creditDays      Int?
  email           String?
  gstin           String?
  status          CustomerStatus      @default(ACTIVE)
  notes           String?
  pan             String?
  paymentTerms    Int?
  creditStatus    String              @default("GOOD") // GOOD, HOLD, BLOCKED
  phone           String?
  shippingAddress Json?
  branch          Branch?             @relation(fields: [branchId], references: [id])
  company         Company             @relation(fields: [companyId], references: [id])
  salesOrders     SalesOrder[]
  sampleRequests  SampleRequest[]
  payments        CustomerPayment[]
  ledgers         CustomerLedger[]
  complaints      CustomerComplaint[]

  @@unique([companyId, gstin])
  @@index([companyId, status])
  @@index([companyId, companyName])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@index([companyId, gstin])
}

model Lead {
  id         String @id @default(uuid())
  leadNumber String @unique

  leadDate    DateTime? @default(now())

  companyName   String
  groupName     String?
  projectName   String?
  contactPerson String
  email         String?
  phone         String?
  gstName       String?
  gstNumber     String?
  address       Json?

  source            LeadSource?
  productInterest   String?
  detailedItems     Json?
  estimatedQuantity Decimal?    @db.Decimal(18, 3)
  unit              String?

  workflowStateId String?
  workflowState   WorkflowState? @relation(fields: [workflowStateId], references: [id])

  assignedToId String?
  customerId   String?

  convertedCustomerId String?
  convertedAt         DateTime?
  convertedById       String?

  nextReminder DateTime?
  lostReason     String?
  remarks        String?

  version Int @default(1)

  createdById String
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  companyId      String?
  Company        Company?        @relation(fields: [companyId], references: [id])
  sampleRequests SampleRequest[]
  quotations     Quotation[]
  activities     LeadActivity[]
  followUps      FollowUp[]

  salesExecutiveId String?
  salesExecutive   User?   @relation("SalesExecutiveLeads", fields: [salesExecutiveId], references: [id])

  @@index([workflowStateId])
  @@index([assignedToId])
  @@index([salesExecutiveId])
  @@index([companyName])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  companyId   String?
  branchId    String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  userId         String
  route          String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([userId, key])
}

model Product {
  id                          String                       @id @default(uuid())
  publicId                    String                       @unique
  companyId                   String
  name                        String
  sku                         String?
  description                 String?
  category                    String?
  productType                 String?                      @default("MANUFACTURING")
  brand                       String?
  dispatchCategory            String?
  gstRate                     Decimal?                     @db.Decimal(5, 2)
  hsnCode                     String?
  variantDetails              String?
  weight                      Decimal?                     @db.Decimal(10, 3)
  imageUrl                    String?
  unit                        String
  unitPrice                   Decimal                      @db.Decimal(14, 2)
  minimumStock                Decimal                      @default(0) @db.Decimal(14, 2)
  reorderQuantity             Decimal?                     @db.Decimal(14, 2)
  reorderUnit                 String?
  leadTimeDays                Int?
  preferredVendorId           String?
  isAutoReorderEnabled        Boolean                      @default(false)
  isActive                    Boolean                      @default(true)
  version                     Int                          @default(1)
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  inventoryTransactions       InventoryTransaction[]
  materialRequestItems        MaterialRequestItem[]
  company                     Company                      @relation(fields: [companyId], references: [id])
  purchaseIndentItems         PurchaseIndentItem[]
  salesOrderItems             SalesOrderItem[]
  quotationItems              QuotationItem[]
  salesReturnItems            SalesReturnItem[]
  replacementRequestItems     ReplacementRequestItem[]
  replacementOrderItems       ReplacementOrderItem[]
  SampleItem                  SampleItem[]
  PurchaseOrderItem           PurchaseOrderItem[]
  GoodsReceiptNoteItem        GoodsReceiptNoteItem[]
  complaints                  CustomerComplaint[]
  VendorReturnItem            VendorReturnItem[]
  VendorInvoiceItem           VendorInvoiceItem[]
  preferredVendor             Supplier?                    @relation("PreferredVendor", fields: [preferredVendorId], references: [id], onDelete: SetNull)
  deliveryItems               ProcurementDeliveryItem[]
  materialRejectionItems      MaterialRejectionItem[]
  procurementReplacementItems ProcurementReplacementItem[]
  productSuppliers            ProductSupplier[]
  FinishedGoods               FinishedGoods[]

  size                        String?
  type                        String?
  capacity                    String?
  coverUnitWeight             Decimal?                     @db.Decimal(10, 3)
  frameUnitWeight             Decimal?                     @db.Decimal(10, 3)
  coversPerSet                Int?                         @default(1)
  framesPerSet                Int?                         @default(1)
  dailyReportItems            ProductionDailyReportItem[]

  @@index([companyId, minimumStock])
  @@index([preferredVendorId])
}

model Warehouse {
  id                    String                 @id @default(uuid())
  companyId             String
  branchId              String?
  name                  String
  location              String?
  inventoryTransactions InventoryTransaction[]
  
  branch                Branch?                @relation(fields: [branchId], references: [id])
  company               Company                @relation(fields: [companyId], references: [id])
  GoodsReceiptNote      GoodsReceiptNote[]
  ProcurementDelivery   ProcurementDelivery[]
}

model InventoryTransaction {
  id            String       @id @default(uuid())
  companyId     String
  productId     String?
  rawMaterialId String?
  warehouseId   String
  type          String
  quantity      Decimal      @db.Decimal(14, 2)
  referenceId   String?
  referenceType String?
  createdAt     DateTime     @default(now())
  company       Company      @relation(fields: [companyId], references: [id])
  product       Product?     @relation(fields: [productId], references: [id])
  rawMaterial   RawMaterial? @relation(fields: [rawMaterialId], references: [id])
  warehouse     Warehouse    @relation(fields: [warehouseId], references: [id])
}

model Supplier {
  id                             String                          @id @default(uuid())
  publicId                       String                          @unique
  companyId                      String
  name                           String
  contact                        String?
  email                          String?
  phone                          String?
  gstin                          String?
  isActive                       Boolean                         @default(true)
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt                      DateTime                        @updatedAt
  company                        Company                         @relation(fields: [companyId], references: [id])
  PurchaseOrder                  PurchaseOrder[]
  VendorReturn                   VendorReturn[]
  SupplierPayable                SupplierPayable[]
  vendorInvoices                 VendorInvoice[]
  vendorPayments                 VendorPayment[]
  preferredProducts              Product[]                       @relation("PreferredVendor")
  deliveries                     ProcurementDelivery[]
  materialRejections             MaterialRejection[]
  procurementReplacementRequests ProcurementReplacementRequest[]
  productSuppliers               ProductSupplier[]
}

model MaterialRequest {
  id            String                @id @default(uuid())
  publicId      String                @unique
  companyId     String
  branchId      String?
  requestedById String
  requestDate   DateTime              @default(now())
  status        String
  workOrderNo   String?
  warehouse     String?
  priority      String?
  notes         String?
  approvedById  String?
  approvedAt    DateTime?
  metadata      Json?
  version       Int      @default(1)
  createdAt     DateTime @default(now())
  updatedAt     DateTime              @updatedAt
  branch        Branch?               @relation(fields: [branchId], references: [id])
  company       Company               @relation(fields: [companyId], references: [id])
  requestedBy   User                  @relation(fields: [requestedById], references: [id])
  items         MaterialRequestItem[]
}

model MaterialRequestItem {
  id                String          @id @default(uuid())
  materialRequestId String
  productId         String
  quantity          Decimal         @db.Decimal(14, 2)
  approvedQuantity  Decimal?        @db.Decimal(14, 2)
  issuedQuantity    Decimal?        @db.Decimal(14, 2)
  receivedQuantity  Decimal?        @db.Decimal(14, 2)
  consumedQuantity  Decimal?        @db.Decimal(14, 2)
  returnedQuantity  Decimal?        @db.Decimal(14, 2)
  unit              String?
  status            String
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])
}

model PurchaseIndent {
  id                         String                        @id @default(uuid())
  publicId                   String                        @unique
  indentNo                   String?                       @unique
  companyId                  String
  requestedById              String
  indentDate                 DateTime                      @default(now())
  status                     String
  department                 String?
  warehouseId                String?
  requiredDate               DateTime?
  priority                   String?                       @default("NORMAL")
  businessReason             String?
  remarks                    String?
  cancellationReason         String?
  version                    Int                           @default(1)
  plantHeadApprovedById      String?
  plantHeadApprovedAt        DateTime?
  plantHeadRejectedById      String?
  plantHeadRejectedAt        DateTime?
  plantHeadRejectionReason   String?
  closedAt                   DateTime?
  createdAt                  DateTime                      @default(now())
  updatedAt                  DateTime                      @updatedAt
  company                    Company                       @relation(fields: [companyId], references: [id])
  requestedBy                User                          @relation(fields: [requestedById], references: [id])
  items                      PurchaseIndentItem[]
  history                    PurchaseIndentStatusHistory[]
  purchaseOrder              PurchaseOrder?

  @@index([status])
  @@index([requiredDate])
}

model PurchaseIndentItem {
  id                    String         @id @default(uuid())
  purchaseIndentId      String
  productId             String
  quantity              Decimal        @db.Decimal(14, 2)
  approvedQuantity      Decimal?       @db.Decimal(14, 2)
  estimatedUnitRate     Decimal?       @db.Decimal(14, 2)
  lineRemarks           String?
  materialReqItemId     String?
  materialCode          String?
  materialName          String?
  uom                   String?
  currentStockSnapshot  Decimal?       @db.Decimal(14, 2)
  minimumStockSnapshot  Decimal?       @db.Decimal(14, 2)
  product               Product        @relation(fields: [productId], references: [id])
  purchaseIndent        PurchaseIndent @relation(fields: [purchaseIndentId], references: [id], onDelete: Cascade)
}

model PurchaseIndentStatusHistory {
  id               String         @id @default(uuid())
  purchaseIndentId String
  oldStatus        String?
  newStatus        String
  remarks          String?
  actorId          String?
  requestId        String?
  versionBefore    Int?
  versionAfter     Int?
  createdAt        DateTime       @default(now())
  purchaseIndent   PurchaseIndent @relation(fields: [purchaseIndentId], references: [id], onDelete: Cascade)

  @@index([purchaseIndentId, createdAt])
}

enum EmployeeStatus {
  DRAFT
  ACTIVE
  ON_PROBATION
  CONFIRMED
  ON_LEAVE
  SUSPENDED
  RESIGNED
  TERMINATED
  RETIRED
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum BankAccountType {
  SAVINGS
  CURRENT
  SALARY
  OTHER
}

enum EmployeeDocumentType {
  AADHAAR_CARD
  PAN_CARD
  BANK_PASSBOOK
  CANCELLED_CHEQUE
  RESUME
  PASSPORT
  DRIVING_LICENCE
  EDUCATION_CERTIFICATE
  EXPERIENCE_CERTIFICATE
  APPOINTMENT_LETTER
  SALARY_SLIP
  POLICE_VERIFICATION
  MEDICAL_CERTIFICATE
  PHOTOGRAPH
  SIGNATURE
  OTHER
}

enum EmployeeDocumentStatus {
  UPLOADED
  VERIFIED
  REJECTED
  EXPIRED
}

model Department {
  id        String     @id @default(uuid())
  companyId String
  code      String
  name      String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]
  leaveRequests LeaveRequest[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model WorkLocation {
  id        String     @id @default(uuid())
  companyId String
  code      String
  name      String
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  company   Company    @relation(fields: [companyId], references: [id])
  employees Employee[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model Employee {
  id                     String                             @id @default(uuid())
  publicId               String                             @unique
  companyId              String
  userId                 String?                            @unique
  employeeCode           String                             @unique
  firstName              String
  lastName               String
  fullName               String
  dateOfBirth            DateTime
  gender                 Gender
  jobTitle               String
  departmentId           String
  reportingManagerId     String?
  workLocationId         String
  employmentType         EmploymentType
  joiningDate            DateTime
  probationEndDate       DateTime?
  status                 EmployeeStatus                     @default(ACTIVE)
  workEmail              String                             @unique
  personalEmail          String?
  phoneNumber            String
  residentialAddress     String
  emergencyContactName   String
  emergencyContactPhone  String
  emergencyRelationship  String
  panNumber              String                             @unique
  aadhaarNumberEncrypted String
  aadhaarLastFour        String
  aadhaarHash            String                             @unique
  uanNumber              String?
  esicNumber             String?
  bankName               String
  accountHolderName      String
  bankAccountType        BankAccountType
  bankAccountEncrypted   String
  bankAccountLastFour    String
  bankAccountHash        String
  ifscCode               String
  branchName             String?
  baseSalary             Decimal                            @default(0) @db.Decimal(14, 2)
  version                Int                                @default(1)
  createdAt              DateTime                           @default(now())
  updatedAt              DateTime                           @updatedAt
  createdById            String?
  updatedById            String?
  company                Company                            @relation(fields: [companyId], references: [id])
  user                   User?                              @relation(fields: [userId], references: [id])
  department             Department                         @relation(fields: [departmentId], references: [id])
  workLocation           WorkLocation                       @relation(fields: [workLocationId], references: [id])
  reportingManager       Employee?                          @relation("EmployeeReportingManager", fields: [reportingManagerId], references: [id])
  directReports          Employee[]                         @relation("EmployeeReportingManager")
  documents              EmployeeDocument[]
  salarySlips            SalarySlip[]
  salaryStructures       EmployeeSalaryStructure[]
  attendanceSummaries    EmployeeMonthlyAttendanceSummary[]
  payrollRecords         PayrollRecord[]
  completedDraft         EmployeeDraft?                     @relation("CompletedEmployeeDraft")
  leaveRequests          LeaveRequest[]
  manualAttendanceRequests ManualAttendanceRequest[]
  attendances            Attendance[]

  @@index([companyId, status])
  @@index([departmentId])
  @@index([workLocationId])
  @@index([reportingManagerId])
  @@index([fullName])
  @@index([phoneNumber])
}

model EmployeeDraft {
  id                  String    @id @default(uuid())
  companyId           String
  createdById         String
  employeeData        Json
  completedEmployeeId String?   @unique
  version             Int       @default(1)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  completedEmployee   Employee? @relation("CompletedEmployeeDraft", fields: [completedEmployeeId], references: [id])

  @@index([companyId, createdById])
}

model EmployeeDocument {
  id               String                 @id @default(uuid())
  employeeId       String
  documentType     EmployeeDocumentType
  documentName     String
  originalFileName String
  storedFileName   String
  storageKey       String
  mimeType         String
  fileSize         Int
  description      String?
  expiryDate       DateTime?
  status           EmployeeDocumentStatus @default(UPLOADED)
  verifiedAt       DateTime?
  verifiedById     String?
  rejectionReason  String?
  uploadedAt       DateTime               @default(now())
  uploadedById     String?
  employee         Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([documentType])
  @@index([status])
}

enum PayrollPeriodStatus {
  OPEN
  ATTENDANCE_LOCKED
  PAYROLL_PROCESSING
  PAYROLL_COMPLETED
  CLOSED
}

enum PayrollStatus {
  DRAFT
  HR_VERIFIED
  PENDING_SUPER_ADMIN_APPROVAL
  SUPER_ADMIN_APPROVED
  ON_HOLD
  RETURNED_TO_HR
  REJECTED
  PENDING_FINANCE
  PROCESSING
  PAID
  CANCELLED
}

enum PayrollAdjustmentType {
  BONUS
  INCENTIVE
  OVERTIME
  ARREARS
  REIMBURSEMENT
  OTHER_EARNING
  LEAVE_DEDUCTION
  LOAN_DEDUCTION
  ADVANCE_DEDUCTION
  TAX_DEDUCTION
  OTHER_DEDUCTION
}

enum SalaryPaymentMode {
  BANK_TRANSFER
  NEFT
  RTGS
  IMPS
  UPI
  CHEQUE
  CASH
  OTHER
}

model PayrollPeriod {
  id             String                             @id @default(uuid())
  companyId      String                             @default("COMP-001")
  month          Int
  year           Int
  startDate      DateTime
  endDate        DateTime
  status         PayrollPeriodStatus                @default(OPEN)
  lockedAt       DateTime?
  lockedById     String?
  closedAt       DateTime?
  closedById     String?
  createdAt      DateTime                           @default(now())
  updatedAt      DateTime                           @updatedAt
  payrollRecords PayrollRecord[]
  summaries      EmployeeMonthlyAttendanceSummary[]

  @@unique([companyId, month, year])
  @@index([status])
}

model EmployeeSalaryStructure {
  id                  String    @id @default(uuid())
  employeeId          String
  effectiveFrom       DateTime
  effectiveTo         DateTime?
  basicSalary         Decimal   @db.Decimal(14, 2)
  hra                 Decimal   @default(0) @db.Decimal(14, 2)
  conveyanceAllowance Decimal   @default(0) @db.Decimal(14, 2)
  specialAllowance    Decimal   @default(0) @db.Decimal(14, 2)
  otherAllowance      Decimal   @default(0) @db.Decimal(14, 2)
  pfApplicable        Boolean   @default(false)
  esicApplicable      Boolean   @default(false)
  professionalTax     Boolean   @default(false)
  tdsApplicable       Boolean   @default(false)
  grossSalary         Decimal   @db.Decimal(14, 2)
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  employee            Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId, effectiveFrom])
}

model EmployeeMonthlyAttendanceSummary {
  id              String         @id @default(uuid())
  employeeId      String
  payrollPeriodId String
  calendarDays    Decimal        @default(0) @db.Decimal(6, 2)
  workingDays     Decimal        @default(0) @db.Decimal(6, 2)
  presentDays     Decimal        @default(0) @db.Decimal(6, 2)
  paidLeaveDays   Decimal        @default(0) @db.Decimal(6, 2)
  unpaidLeaveDays Decimal        @default(0) @db.Decimal(6, 2)
  halfDays        Decimal        @default(0) @db.Decimal(6, 2)
  absentDays      Decimal        @default(0) @db.Decimal(6, 2)
  weeklyOffDays   Decimal        @default(0) @db.Decimal(6, 2)
  holidayDays     Decimal        @default(0) @db.Decimal(6, 2)
  payableDays     Decimal        @default(0) @db.Decimal(6, 2)
