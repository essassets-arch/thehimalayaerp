generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model IdSequence {
  key       String   @id
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

model Company {
  id                    String                 @id @default(uuid())
  publicId              String                 @unique
  name                  String
  version               Int                    @default(1)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  createdById           String?
  updatedById           String?
  deletedAt             DateTime?
  branches              Branch[]
  customers             Customer[]
  employees             Employee[]
  inventoryTransactions InventoryTransaction[]
  leads                 Lead[]
  materialRequests      MaterialRequest[]
  products              Product[]
  purchaseIndents       PurchaseIndent[]
  suppliers             Supplier[]
  users                 User[]
  warehouses            Warehouse[]
}

model Branch {
  id               String            @id @default(uuid())
  publicId         String            @unique
  name             String
  companyId        String
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdById      String?
  updatedById      String?
  deletedAt        DateTime?
  company          Company           @relation(fields: [companyId], references: [id])
  customers        Customer[]
  materialRequests MaterialRequest[]
  warehouses       Warehouse[]
}

model Role {
  id              String           @id @default(uuid())
  publicId        String           @unique
  name            String
  code            String           @unique
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?
  updatedById     String?
  deletedAt       DateTime?
  rolePermissions RolePermission[]
  users           User[]
}

model Permission {
  id              String           @id @default(uuid())
  publicId        String           @unique
  name            String
  code            String           @unique
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?
  updatedById     String?
  deletedAt       DateTime?
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model User {
  id               String            @id @default(uuid())
  publicId         String            @unique
  email            String            @unique
  password         String
  name             String
  roleId           String
  companyId        String
  isActive         Boolean           @default(true)
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdById      String?
  updatedById      String?
  deletedAt        DateTime?
  employee         Employee?
  materialRequests MaterialRequest[]
  purchaseIndents  PurchaseIndent[]
  refreshSessions  RefreshSession[]
  company          Company           @relation(fields: [companyId], references: [id])
  role             Role              @relation(fields: [roleId], references: [id])
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id              String       @id @default(uuid())
  publicId        String       @unique
  companyId       String
  version         Int          @default(1)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  createdById     String?
  updatedById     String?
  deletedAt       DateTime?
  alternatePhone  String?
  billingAddress  Json?
  branchId        String?
  companyName     String
  contactPerson   String?
  creditLimit     Decimal?     @db.Decimal(14, 2)
  email           String?
  gstin           String?
  isActive        Boolean      @default(true)
  notes           String?
  pan             String?
  paymentTerms    Int?
  phone           String?
  shippingAddress Json?
  branch          Branch?      @relation(fields: [branchId], references: [id])
  company         Company      @relation(fields: [companyId], references: [id])
  salesOrders     SalesOrder[]

  @@unique([companyId, gstin])
  @@index([companyId, isActive])
  @@index([companyId, companyName])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@index([companyId, gstin])
}

model Lead {
  id         String @id @default(uuid())
  leadNumber String @unique

  companyName   String
  contactPerson String
  email         String?
  phone         String?

  source            LeadSource?
  productInterest   String?
  estimatedQuantity Decimal?    @db.Decimal(18, 3)
  unit              String?

  leadStatus          LeadStatus
  qualificationStatus LeadQualificationStatus?

  assignedToId String?
  customerId   String?

  nextReminderAt DateTime?
  lostReason     String?
  remarks        String?

  version Int @default(1)

  createdById String
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  followups LeadFollowup[]
  reminders LeadReminder[]
  Company   Company?       @relation(fields: [companyId], references: [id])
  companyId String?

  @@index([leadStatus])
  @@index([assignedToId])
  @@index([companyName])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
}

model LeadFollowup {
  id     String @id @default(uuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  followupType String
  notes        String
  nextActionAt DateTime?
  createdById  String
  createdAt    DateTime  @default(now())

  @@index([leadId])
  @@index([nextActionAt])
}

model LeadReminder {
  id     String @id @default(uuid())
  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  reminderAt  DateTime
  message     String?
  completedAt DateTime?
  createdById String
  createdAt   DateTime  @default(now())

  @@index([leadId])
  @@index([reminderAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  companyId   String?
  branchId    String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  userId         String
  route          String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([userId, key])
}

model Product {
  id                      String                   @id @default(uuid())
  publicId                String                   @unique
  companyId               String
  name                    String
  sku                     String?
  description             String?
  category                String?
  unit                    String
  unitPrice               Decimal                  @db.Decimal(14, 2)
  isActive                Boolean                  @default(true)
  version                 Int                      @default(1)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  inventoryTransactions   InventoryTransaction[]
  materialRequestItems    MaterialRequestItem[]
  company                 Company                  @relation(fields: [companyId], references: [id])
  purchaseIndentItems     PurchaseIndentItem[]
  salesOrderItems         SalesOrderItem[]
  salesReturnItems        SalesReturnItem[]
  replacementRequestItems ReplacementRequestItem[]
  replacementOrderItems   ReplacementOrderItem[]
}

model Warehouse {
  id                    String                 @id @default(uuid())
  companyId             String
  branchId              String?
  name                  String
  location              String?
  inventoryTransactions InventoryTransaction[]
  branch                Branch?                @relation(fields: [branchId], references: [id])
  company               Company                @relation(fields: [companyId], references: [id])
}

model InventoryTransaction {
  id            String    @id @default(uuid())
  companyId     String
  productId     String
  warehouseId   String
  type          String
  quantity      Decimal   @db.Decimal(14, 2)
  referenceId   String?
  referenceType String?
  createdAt     DateTime  @default(now())
  company       Company   @relation(fields: [companyId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
}

model Supplier {
  id        String   @id @default(uuid())
  publicId  String   @unique
  companyId String
  name      String
  contact   String?
  email     String?
  phone     String?
  gstin     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  company   Company  @relation(fields: [companyId], references: [id])
}

model MaterialRequest {
  id            String                @id @default(uuid())
  publicId      String                @unique
  companyId     String
  branchId      String?
  requestedById String
  requestDate   DateTime              @default(now())
  status        String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  branch        Branch?               @relation(fields: [branchId], references: [id])
  company       Company               @relation(fields: [companyId], references: [id])
  requestedBy   User                  @relation(fields: [requestedById], references: [id])
  items         MaterialRequestItem[]
}

model MaterialRequestItem {
  id                String          @id @default(uuid())
  materialRequestId String
  productId         String
  quantity          Decimal         @db.Decimal(14, 2)
  status            String
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])
}

model PurchaseIndent {
  id            String               @id @default(uuid())
  publicId      String               @unique
  companyId     String
  requestedById String
  indentDate    DateTime             @default(now())
  status        String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  company       Company              @relation(fields: [companyId], references: [id])
  requestedBy   User                 @relation(fields: [requestedById], references: [id])
  items         PurchaseIndentItem[]
}

model PurchaseIndentItem {
  id                String         @id @default(uuid())
  purchaseIndentId  String
  productId         String
  quantity          Decimal        @db.Decimal(14, 2)
  materialReqItemId String?
  product           Product        @relation(fields: [productId], references: [id])
  purchaseIndent    PurchaseIndent @relation(fields: [purchaseIndentId], references: [id], onDelete: Cascade)
}

model Employee {
  id          String       @id @default(uuid())
  publicId    String       @unique
  companyId   String
  userId      String?      @unique
  firstName   String
  lastName    String
  email       String?
  phone       String?
  hireDate    DateTime
  department  String?
  jobTitle    String?
  baseSalary  Decimal      @db.Decimal(14, 2)
  status      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  company     Company      @relation(fields: [companyId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])
  salarySlips SalarySlip[]
}

model SalarySlip {
  id         String   @id @default(uuid())
  publicId   String   @unique
  employeeId String
  month      Int
  year       Int
  basePay    Decimal  @db.Decimal(14, 2)
  allowances Decimal  @db.Decimal(14, 2)
  deductions Decimal  @db.Decimal(14, 2)
  netPay     Decimal  @db.Decimal(14, 2)
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model Quotation {
  id         String      @id @default(uuid())
  publicId   String      @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  salesOrder SalesOrder?
}

model SalesOrder {
  id                           String                      @id @default(uuid())
  orderNumber                  String                      @unique
  customerId                   String
  quotationId                  String?                     @unique
  customerPurchaseOrderNo      String?
  customerPurchaseOrderDate    DateTime?
  customerPurchaseOrderFileUrl String?
  orderDate                    DateTime                    @default(now())
  requestedDeliveryDate        DateTime?
  confirmedAt                  DateTime?
  subtotal                     Decimal                     @db.Decimal(18, 2)
  discountAmount               Decimal                     @default(0) @db.Decimal(18, 2)
  taxableAmount                Decimal                     @db.Decimal(18, 2)
  taxAmount                    Decimal                     @default(0) @db.Decimal(18, 2)
  freightAmount                Decimal                     @default(0) @db.Decimal(18, 2)
  totalAmount                  Decimal                     @db.Decimal(18, 2)
  currency                     String                      @default("INR")
  paymentTermsDays             Int?
  deliveryTerms                String?
  billingAddress               Json?
  shippingAddress              Json?
  remarks                      String?
  orderStatus                  SalesOrderStatus
  creditStatus                 CreditStatus
  allocationStatus             AllocationStatus
  productionStatus             ProductionStatus
  qcStatus                     QcStatus
  dispatchStatus               DispatchStatus
  invoiceStatus                InvoiceStatus
  paymentStatus                PaymentStatus
  closureStatus                OrderClosureStatus
  version                      Int                         @default(1)
  createdById                  String
  updatedById                  String?
  createdAt                    DateTime                    @default(now())
  updatedAt                    DateTime                    @updatedAt
  deletedAt                    DateTime?
  paymentAllocations           CustomerPaymentAllocation[]
  replacementOrders            ReplacementOrder[]
  invoices                     SalesInvoice[]
  customer                     Customer                    @relation(fields: [customerId], references: [id])
  quotation                    Quotation?                  @relation(fields: [quotationId], references: [id])
  allocations                  SalesOrderAllocation[]
  creditReviews                SalesOrderCreditReview[]
  histories                    SalesOrderHistory[]
  items                        SalesOrderItem[]
  returns                      SalesReturn[]

  @@index([customerId])
  @@index([orderStatus])
  @@index([productionStatus])
  @@index([dispatchStatus])
  @@index([paymentStatus])
  @@index([createdAt])
}

model SalesOrderItem {
  id                      String                   @id @default(uuid())
  salesOrderId            String
  productId               String
  productNameSnapshot     String
  productCodeSnapshot     String?
  specifications          Json?
  orderedQuantity         Decimal                  @db.Decimal(18, 3)
  unit                    String
  unitPrice               Decimal                  @db.Decimal(18, 2)
  discountAmount          Decimal                  @default(0) @db.Decimal(18, 2)
  taxableAmount           Decimal                  @db.Decimal(18, 2)
  taxRate                 Decimal                  @default(0) @db.Decimal(8, 3)
  taxAmount               Decimal                  @default(0) @db.Decimal(18, 2)
  lineTotal               Decimal                  @db.Decimal(18, 2)
  reservedQuantity        Decimal                  @default(0) @db.Decimal(18, 3)
  productionQuantity      Decimal                  @default(0) @db.Decimal(18, 3)
  qcApprovedQuantity      Decimal                  @default(0) @db.Decimal(18, 3)
  dispatchedQuantity      Decimal                  @default(0) @db.Decimal(18, 3)
  deliveredQuantity       Decimal                  @default(0) @db.Decimal(18, 3)
  returnedQuantity        Decimal                  @default(0) @db.Decimal(18, 3)
  replacedQuantity        Decimal                  @default(0) @db.Decimal(18, 3)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  product                 Product                  @relation(fields: [productId], references: [id])
  salesOrder              SalesOrder               @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  replacementRequestItems ReplacementRequestItem[]

  @@index([salesOrderId])
  @@index([productId])
}

model SalesOrderCreditReview {
  id                  String             @id @default(uuid())
  salesOrderId        String
  outstandingAmount   Decimal            @db.Decimal(18, 2)
  approvedCreditLimit Decimal            @db.Decimal(18, 2)
  availableCredit     Decimal            @db.Decimal(18, 2)
  paymentTermsDays    Int?
  result              CreditReviewResult
  reviewedById        String?
  approvedById        String?
  approvalRemarks     String?
  reviewedAt          DateTime           @default(now())
  approvedAt          DateTime?
  salesOrder          SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
}

model SalesOrderAllocation {
  id                 String              @id @default(uuid())
  salesOrderId       String
  salesOrderItemId   String
  allocationType     SalesAllocationType
  requiredQuantity   Decimal             @db.Decimal(18, 3)
  reservedQuantity   Decimal             @default(0) @db.Decimal(18, 3)
  productionQuantity Decimal             @default(0) @db.Decimal(18, 3)
  workOrderId        String?
  inventoryBatchId   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  salesOrder         SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@index([salesOrderItemId])
}

model CustomerComplaint {
  id                   String                  @id @default(uuid())
  complaintNumber      String                  @unique
  customerId           String
  salesOrderId         String
  invoiceId            String?
  complaintType        CustomerComplaintType
  description          String
  evidence             Json?
  complaintStatus      CustomerComplaintStatus
  raisedById           String
  assignedToId         String?
  raisedAt             DateTime                @default(now())
  resolvedAt           DateTime?
  replacementRequestId String?
  replacementRequest   ReplacementRequest?     @relation(fields: [replacementRequestId], references: [id])
  returnRequest        SalesReturn?

  @@index([customerId])
  @@index([salesOrderId])
  @@index([complaintStatus])
}

model SalesReturn {
  id              String               @id @default(uuid())
  returnNumber    String               @unique
  rmaNumber       String               @unique
  salesOrderId    String
  complaintId     String?              @unique
  reasonCode      ReturnReasonCode
  customerRemarks String?
  internalRemarks String?
  pickupRequired  Boolean              @default(true)
  pickupAddress   Json?
  resolutionType  ReturnResolutionType
  returnStatus    ReturnStatus
  requestedById   String
  reviewedById    String?
  approvedById    String?
  requestedAt     DateTime             @default(now())
  reviewedAt      DateTime?
  approvedAt      DateTime?
  receivedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  creditNotes     CreditNote[]
  gateEntries     ReturnGateEntry[]
  inspections     ReturnQcInspection[]
  complaint       CustomerComplaint?   @relation(fields: [complaintId], references: [id])
  salesOrder      SalesOrder           @relation(fields: [salesOrderId], references: [id])
  items           SalesReturnItem[]

  @@index([salesOrderId])
  @@index([returnStatus])
}

model SalesReturnItem {
  id                    String      @id @default(uuid())
  salesReturnId         String
  salesOrderItemId      String
  productId             String
  deliveredQuantity     Decimal     @db.Decimal(18, 3)
  previouslyReturnedQty Decimal     @default(0) @db.Decimal(18, 3)
  requestedQuantity     Decimal     @db.Decimal(18, 3)
  approvedQuantity      Decimal     @default(0) @db.Decimal(18, 3)
  receivedQuantity      Decimal     @default(0) @db.Decimal(18, 3)
  goodQuantity          Decimal     @default(0) @db.Decimal(18, 3)
  defectiveQuantity     Decimal     @default(0) @db.Decimal(18, 3)
  scrapQuantity         Decimal     @default(0) @db.Decimal(18, 3)
  reworkQuantity        Decimal     @default(0) @db.Decimal(18, 3)
  conditionReported     String?
  reason                String
  evidence              Json?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  product               Product     @relation(fields: [productId], references: [id])
  salesReturn           SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)

  @@index([salesReturnId])
  @@index([salesOrderItemId])
}

model ReturnQcInspection {
  id                 String                   @id @default(uuid())
  salesReturnId      String
  inspectorId        String
  inspectionResult   ReturnInspectionResult
  inspectionNotes    String?
  inspectionEvidence Json?
  inspectedAt        DateTime                 @default(now())
  salesReturn        SalesReturn              @relation(fields: [salesReturnId], references: [id])
  itemResults        ReturnQcInspectionItem[]

  @@index([salesReturnId])
}

model ReturnQcInspectionItem {
  id                   String             @id @default(uuid())
  returnQcInspectionId String
  createdAt            DateTime           @default(now())
  returnQcInspection   ReturnQcInspection @relation(fields: [returnQcInspectionId], references: [id], onDelete: Cascade)
}

model ReplacementRequest {
  id                String                   @id @default(uuid())
  requestNumber     String                   @unique
  complaintId       String?                  @unique
  salesOrderId      String
  returnId          String?
  replacementStatus ReplacementRequestStatus
  reasonCode        ReplacementReasonCode
  customerRemarks   String?
  internalRemarks   String?
  evidence          Json?
  requestedById     String
  reviewedById      String?
  approvedById      String?
  requestedAt       DateTime                 @default(now())
  reviewedAt        DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  CustomerComplaint CustomerComplaint[]
  replacementOrder  ReplacementOrder?
  items             ReplacementRequestItem[]

  @@index([salesOrderId])
  @@index([replacementStatus])
}

model ReplacementRequestItem {
  id                   String             @id @default(uuid())
  replacementRequestId String
  salesOrderItemId     String
  productId            String
  requestedQuantity    Decimal            @db.Decimal(18, 3)
  reason               String
  evidence             Json?
  createdAt            DateTime           @default(now())
  product              Product            @relation(fields: [productId], references: [id])
  salesOrderItem       SalesOrderItem     @relation(fields: [salesOrderItemId], references: [id])
  replacementRequest   ReplacementRequest @relation(fields: [replacementRequestId], references: [id], onDelete: Cascade)
}

model ReplacementOrder {
  id                   String                    @id @default(uuid())
  replacementOrderNo   String                    @unique
  originalSalesOrderId String
  replacementRequestId String                    @unique
  commercialValue      Decimal                   @default(0) @db.Decimal(18, 2)
  replacementStatus    ReplacementOrderStatus
  allocationStatus     AllocationStatus
  productionStatus     ProductionStatus
  qcStatus             QcStatus
  dispatchStatus       DispatchStatus
  deliveryAddress      Json?
  remarks              String?
  createdById          String
  approvedById         String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  deliveredAt          DateTime?
  closedAt             DateTime?
  originalSalesOrder   SalesOrder                @relation(fields: [originalSalesOrderId], references: [id])
  replacementRequest   ReplacementRequest        @relation(fields: [replacementRequestId], references: [id])
  histories            ReplacementOrderHistory[]
  items                ReplacementOrderItem[]

  @@index([originalSalesOrderId])
  @@index([replacementStatus])
}

model ReplacementOrderItem {
  id                 String           @id @default(uuid())
  replacementOrderId String
  productId          String
  quantity           Decimal          @db.Decimal(18, 3)
  createdAt          DateTime         @default(now())
  product            Product          @relation(fields: [productId], references: [id])
  replacementOrder   ReplacementOrder @relation(fields: [replacementOrderId], references: [id], onDelete: Cascade)
}

model SalesOrderHistory {
  id           String     @id @default(uuid())
  salesOrderId String
  createdAt    DateTime   @default(now())
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
}

model SalesInvoice {
  id           String     @id @default(uuid())
  salesOrderId String
  createdAt    DateTime   @default(now())
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
}

model CustomerPaymentAllocation {
  id           String     @id @default(uuid())
  salesOrderId String
  createdAt    DateTime   @default(now())
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
}

model ReturnGateEntry {
  id            String      @id @default(uuid())
  salesReturnId String
  createdAt     DateTime    @default(now())
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
}

model CreditNote {
  id            String      @id @default(uuid())
  salesReturnId String
  createdAt     DateTime    @default(now())
  salesReturn   SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)
}

model ReplacementOrderHistory {
  id                 String           @id @default(uuid())
  replacementOrderId String
  createdAt          DateTime         @default(now())
  replacementOrder   ReplacementOrder @relation(fields: [replacementOrderId], references: [id], onDelete: Cascade)
}

model LegacyMigrationReference {
  id           String   @id @default(uuid())
  sourceSystem String
  entityType   String
  legacyId     String
  newEntityId  String
  checksum     String?
  migratedAt   DateTime @default(now())

  @@unique([sourceSystem, entityType, legacyId])
  @@index([newEntityId])
}

enum SalesOrderStatus {
  DRAFT
  CUSTOMER_PO_PENDING
  CREDIT_CHECK_PENDING
  CREDIT_HOLD
  CONFIRMED
  SENT_TO_PLANT_HEAD
  PRODUCTION_PLANNED
  FULFILLMENT_IN_PROGRESS
  READY_FOR_DISPATCH
  PARTIALLY_DISPATCHED
  FULLY_DISPATCHED
  DELIVERED
  CANCELLED
}

enum CreditStatus {
  NOT_CHECKED
  PENDING
  PASSED
  HOLD
  APPROVED_EXCEPTION
  REJECTED
}

enum AllocationStatus {
  NOT_ALLOCATED
  CHECKING
  FINISHED_GOODS_RESERVED
  PRODUCTION_REQUIRED
  PARTIALLY_ALLOCATED
  FULLY_ALLOCATED
}

enum ProductionStatus {
  NOT_REQUIRED
  NOT_STARTED
  PLANNED
  WORK_ORDER_CREATED
  IN_PROGRESS
  COMPLETED
  REWORK_REQUIRED
}

enum QcStatus {
  NOT_REQUIRED
  PENDING
  PARTIALLY_APPROVED
