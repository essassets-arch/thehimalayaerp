model OrderAmendment {
  id           String     @id @default(uuid())
  salesOrderId String
  amendmentNo  String     @unique
  reason       String
  changes      Json
  approvedAt   DateTime?
  createdAt    DateTime   @default(now())
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
}

// =============================================================================
// CROSS-CUTTING INFRASTRUCTURE
// These models are shared across all ERP modules (Sales, Production, Finance,
// Procurement, HR). They are intentionally generic using entityType + entityId
// to avoid coupling to specific domain models.
// =============================================================================

// Approval — multi-level approval engine shared across all modules.
// Usage: Sales Order approval, Production Plan approval, Payment approval, etc.
model Approval {
  id           String         @id @default(uuid())
  companyId    String
  entityType   String // SalesOrder, ProductionPlan, Invoice, Payment, PurchaseOrder ...
  entityId     String
  level        Int            @default(1) // Supports multi-level approval chains
  role         String? // Role required to approve at this level
  status       ApprovalStatus @default(PENDING)
  approvedById String?
  rejectedById String?
  remarks      String?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  createdAt    DateTime       @default(now())

  @@index([entityType, entityId])
  @@index([companyId, status])
  @@index([approvedById])
}

// Attachment — generic file attachment shared across all modules.
// Usage: Customer PO on SalesOrder, damage photos on Return, signed invoice, etc.
model Attachment {
  id           String   @id @default(uuid())
  companyId    String
  entityType   String // SalesOrder, Quotation, Return, Invoice, Lead, Complaint ...
  entityId     String
  fileName     String
  fileUrl      String
  mimeType     String?
  fileSize     Int? // in bytes
  uploadedById String
  uploadedAt   DateTime @default(now())

  @@index([entityType, entityId])
  @@index([companyId])
  @@index([uploadedById])
}

// Comment — generic comment / notes thread shared across all modules.
// Replaces ad-hoc `remarks` and `internalRemarks` fields on documents.
model Comment {
  id         String    @id @default(uuid())
  companyId  String
  entityType String // SalesOrder, Lead, Complaint, Return, Invoice ...
  entityId   String
  message    String
  isInternal Boolean   @default(false) // Internal = staff only; false = customer visible
  userId     String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  @@index([entityType, entityId])
  @@index([companyId])
  @@index([userId])
}

// Notification — in-app notification for every workflow action.
// Created by services automatically on status transitions.
model Notification {
  id         String             @id @default(uuid())
  companyId  String
  userId     String // Recipient
  type       String             @default("GENERAL")
  title      String
  message    String
  route      String?
  entityType String? // Optional — links notification to a document
  entityId   String?
  eventKey   String?            @unique
  isRead     Boolean            @default(false)
  status     NotificationStatus @default(UNREAD)
  readAt     DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @default(now()) @updatedAt

  company    Company            @relation(fields: [companyId], references: [id])
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, isRead, createdAt])
  @@index([userId, status])
  @@index([userId, createdAt])
  @@index([companyId])
  @@index([entityType, entityId])
  @@index([eventKey])
}

model FcmDeviceToken {
  id         String   @id @default(uuid())
  companyId  String
  userId     String
  token      String   @unique
  deviceType String   @default("web")
  userAgent  String?
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company    Company  @relation(fields: [companyId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId, userId])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

