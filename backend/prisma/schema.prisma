  credit     Decimal @default(0) @db.Decimal(18, 2)

  referenceType String // e.g. 'SalesInvoice', 'CustomerPayment'
  referenceId   String
  reversalOfId  String?

  description String?
  createdById String?
  createdAt   DateTime @default(now())

