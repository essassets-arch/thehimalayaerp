model RecruitmentRequest {
  id                  String                       @id @default(uuid())
  companyId           String
  company             Company                      @relation(fields: [companyId], references: [id])
  indentNumber        String                       @unique
  designation         String
  department          String
  vacancies           Int
  priority            RecruitmentPriority
  employmentType      EmploymentType?
  requiredExperience  String?
  requiredSkills      String?
  reasonForHiring     String
  jobDescription      String?
  requiredByDate      DateTime?
  requestedById       String
  requestedByName     String
  requestedByRole     String
  assignedHrUserId    String?
  assignedHrUserName  String?
  positionsFilled     Int                          @default(0)
  status              RecruitmentRequestStatus     @default(OPEN)
  submittedAt         DateTime                     @default(now())
  processingStartedAt DateTime?
  fulfilledAt         DateTime?
  rejectedAt          DateTime?
  withdrawnAt         DateTime?
  hrRemarks           String?
  rejectionReason     String?
  correctionReason    String?
  rejectedBy          String?
  fulfilledBy         String?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt
  version             Int                          @default(1)
  candidates          RecruitmentCandidate[]
  interviews          RecruitmentInterview[]
  timeline            RecruitmentRequestTimeline[]

  @@index([companyId, status])
  @@index([department])
  @@index([requestedById])
  @@index([assignedHrUserId])
  @@index([createdAt])
}

model RecruitmentCandidate {
  id                   String                     @id @default(uuid())
  candidateNumber      String                     @unique
  recruitmentRequestId String
  recruitmentRequest   RecruitmentRequest         @relation(fields: [recruitmentRequestId], references: [id], onDelete: Cascade)
  name                 String
  phone                String?
  email                String?
  experience           String?
  currentCompany       String?
  expectedSalary       Decimal?                   @db.Decimal(14, 2)
  resumeUrl            String?
  source               String?
  status               RecruitmentCandidateStatus @default(SOURCED)
  remarks              String?
  selectedAt           DateTime?
  joiningDate          DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  interviews           RecruitmentInterview[]

  @@index([recruitmentRequestId])
  @@index([status])
}

model RecruitmentInterview {
  id                   String               @id @default(uuid())
  recruitmentRequestId String
  candidateId          String
  recruitmentRequest   RecruitmentRequest   @relation(fields: [recruitmentRequestId], references: [id], onDelete: Cascade)
  candidate            RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  interviewDate        DateTime
  interviewMode        String
  interviewLocation    String?
  meetingLink          String?
  interviewRound       String?
  panelMembers         Json?
  instructions         String?
  status               InterviewStatus      @default(SCHEDULED)
  feedback             String?
  rating               Int?
  result               InterviewResult?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([recruitmentRequestId])
  @@index([candidateId])
  @@index([interviewDate])
}

model RecruitmentRequestTimeline {
  id                   String                    @id @default(uuid())
  recruitmentRequestId String
  recruitmentRequest   RecruitmentRequest        @relation(fields: [recruitmentRequestId], references: [id], onDelete: Cascade)
  action               String
  fromStatus           RecruitmentRequestStatus?
  toStatus             RecruitmentRequestStatus?
  performedById        String
  performedByName      String
  performedByRole      String
  remarks              String?
  metadata             Json?
  createdAt            DateTime                  @default(now())

  @@index([recruitmentRequestId])
  @@index([createdAt])
}

enum BrandAnalysisRequestStatus {
