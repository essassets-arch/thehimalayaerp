model FinishedGoods {
  id                String   @id @default(uuid())
  workOrderId       String   @unique
  productId         String
  salesOrderId      String?
  quantity          Decimal
  availableQuantity Decimal
  unit              String
  status            String
  receivedAt        DateTime @default(now())
  receivedById      String?

  workOrder  WorkOrder   @relation(fields: [workOrderId], references: [id])
  product    Product     @relation(fields: [productId], references: [id])
  salesOrder SalesOrder? @relation(fields: [salesOrderId], references: [id])
}


model ElevationSession {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model InventoryItem {
  id         Int      @id @default(autoincrement())
  srNo       Int
  itemName   String   @map("item_name")
  code       String   @unique
  unit       String
  balance    Int
  category   String
  minStock   Int      @map("min_stock")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("inventory_items")
}

enum MachineStatus {
  USE
  NOT_USE
}

model Machine {
  id           BigInt   @id @default(autoincrement())
  machineId    String   @unique @map("machine_id") @db.VarChar(30)
  machineName  String   @map("machine_name") @db.VarChar(150)
  machineType  String   @map("machine_type") @db.VarChar(100)
  serialNumber String?  @map("serial_number") @db.VarChar(100)
  location     String?  @map("location") @db.VarChar(100)
  plantId      BigInt   @map("plant_id") @default(1)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp

  dailyStatuses MachineDailyStatus[]

  @@map("machines")
}

model MachineDailyStatus {
  id          BigInt        @id @default(autoincrement())
  machineId   BigInt        @map("machine_id")
  plantId     BigInt        @map("plant_id") @default(1)
  workDate    DateTime      @map("work_date") @db.Date
  status      MachineStatus @map("status")
  remarks     String?       @map("remarks") @db.VarChar(300)
  updatedById String?       @map("updated_by_id")
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp

  machine     Machine       @relation(fields: [machineId], references: [id])
  updatedBy   User?         @relation("UserMachineStatusUpdates", fields: [updatedById], references: [id])

  @@unique([machineId, workDate])
  @@map("machine_daily_status")
}

enum ProductionTargetStatus {
  ACTIVE
  CANCELLED
}

model ProductionTarget {
  id             String                 @id @default(cuid())
  targetPeriod   TargetPeriod           @map("target_period")
  startDate      DateTime               @map("start_date") @db.Date
  endDate        DateTime               @map("end_date") @db.Date
  quantityTarget Int                    @map("quantity_target")
  remarks        String?                @map("remarks") @db.VarChar(500)
  status         ProductionTargetStatus @default(ACTIVE) @map("status")
  plantId        String?                @map("plant_id")
  createdById    String?                @map("created_by_id")
  updatedById    String?                @map("updated_by_id")
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamp
  updatedAt      DateTime               @updatedAt @map("updated_at") @db.Timestamp

  @@index([startDate, endDate])
  @@index([status, targetPeriod])
  @@map("production_targets")
}

enum ExpenseStatus {
  PENDING_HR
  PENDING_SUPER_ADMIN
  APPROVED
  REJECTED
}

model Expense {
  id              String        @id @default(uuid())
  companyId       String
  employeeId      String
  expenseName     String
  amount          Decimal       @db.Decimal(10, 2)
  expenseDate     DateTime
  receiptUrl      String?       @db.Text
  status          ExpenseStatus @default(PENDING_HR)
  hrApprovedBy    String?
  hrApprovedAt    DateTime?
  superApprovedBy String?
  superApprovedAt DateTime?
  remarks         String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([employeeId])
  @@index([companyId])
}

enum LeaveStatus {
  PENDING_HR
  PENDING_PLANT_HEAD
  PENDING_SUPER_ADMIN
  APPROVED
  REJECTED
}

model LeaveRequest {
  id               String          @id @default(uuid())
  companyId        String
  employeeId       String
  departmentId     String
  leaveType        String
  fromDate         DateTime
  toDate           DateTime
  totalDays        Int
  reason           String
  attachment       String?         @db.Text
  status           LeaveStatus     @default(PENDING_HR)
  currentApprover  String?
  approvedBy       String?
  approvedAt       DateTime?
  remarks          String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  company          Company         @relation(fields: [companyId], references: [id])
  employee         Employee        @relation(fields: [employeeId], references: [id])
  department       Department      @relation(fields: [departmentId], references: [id])
  approvals        LeaveApproval[]

  @@index([employeeId])
  @@index([companyId])
}

model LeaveApproval {
  id             String       @id @default(uuid())
  leaveRequestId String
  approverId     String
  approverRole   String
  action         String
  remarks        String?
  actionDate     DateTime     @default(now())

  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id])

  @@index([leaveRequestId])
}

model ManualAttendanceRequest {
  id          String   @id @default(uuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  date        DateTime
  reason      String
  status      String   @default("PENDING") // PENDING, APPROVED, REJECTED
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([employeeId])
}



model RawMaterial {
  id                    String                 @id @default(uuid())
  publicId              String                 @unique
  companyId             String
  name                  String
  sku                   String?                @unique
  category              String?                @default("Raw Material")
  unit                  String
  minimumStock          Decimal                @default(0) @db.Decimal(14, 2)
  storageLocation       String?
  isActive              Boolean                @default(true)
  version               Int                    @default(1)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  company               Company                @relation(fields: [companyId], references: [id])
  inventoryTransactions InventoryTransaction[]

  @@index([companyId])
  @@index([sku])
}

model ProductionDailyReport {
  id                  String   @id @default(uuid())
  reportNo            String   @unique
  reportDate          DateTime
  shift               String?
  supervisorName      String?
  status              String   @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, REOPENED

  totalCovers         Int      @default(0)
  totalFrames         Int      @default(0)
  totalSets           Int      @default(0)

  totalCoverWeight    Decimal  @default(0) @db.Decimal(14, 3)
  totalFrameWeight    Decimal  @default(0) @db.Decimal(14, 3)
  totalWeight         Decimal  @default(0) @db.Decimal(14, 3)

  createdById         String
  updatedById         String?
  submittedById       String?
  approvedById        String?

  submittedAt         DateTime?
  approvedAt          DateTime?

  companyId           String

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company             Company  @relation(fields: [companyId], references: [id])
  createdBy           User     @relation("DailyReportCreatedBy", fields: [createdById], references: [id])
  approvedBy          User?    @relation("DailyReportApprovedBy", fields: [approvedById], references: [id])

  items               ProductionDailyReportItem[]

  @@unique([companyId, reportDate, shift])
  @@index([companyId, status])
  @@index([reportDate])
}

model ProductionDailyReportItem {
  id                    String   @id @default(uuid())

  reportId              String
  productId             String?
  customProductName     String?

  srNo                  Int

  size                  String?
  type                  String?
  capacity              String?

  coverQty              Int      @default(0)
  coverUnitWeight       Decimal  @default(0) @db.Decimal(10, 3)
  coverWeight           Decimal  @default(0) @db.Decimal(14, 3)
  actualCoverWeight     Decimal? @db.Decimal(14, 3)

  frameQty              Int      @default(0)
  frameUnitWeight       Decimal  @default(0) @db.Decimal(10, 3)
  frameWeight           Decimal  @default(0) @db.Decimal(14, 3)
  actualFrameWeight     Decimal? @db.Decimal(14, 3)

  weightOverrideReason  String?

  setQty                Int      @default(0)
  totalWeight           Decimal  @default(0) @db.Decimal(14, 3)

  workOrderId           String?
  productionPlanId      String?
  salesOrderId          String?
  remarks               String?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  report                ProductionDailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  product               Product?              @relation(fields: [productId], references: [id])

  @@index([reportId])
  @@index([productId])
}

model AttendancePunch {
  id          String   @id @default(uuid())
  empId       String
  empName     String
  type        String   // "PUNCH_IN" | "PUNCH_OUT"
  time        String   // e.g. "09:22 AM"
  date        String   // e.g. "2026-06-11"
  location    String?
  coords      String?
  selfieUrl   String?  @db.Text
  isRealPunch Boolean  @default(true)
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([empId])
  @@index([date])
}

model ShiftPolicy {
  id        String   @id @default(uuid())
  deptName  String   @unique // e.g. "HR", "Sales", "Production", "Finance", "Default"
  checkIn   String   // e.g. "09:00 AM"
  checkOut  String   // e.g. "06:00 PM"
  grace     Int      @default(15)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Attendance {
  id                 String           @id @default(uuid())
  companyId          String
  employeeId         String?
  userId             String
  attendanceDate     DateTime
  punchInAt          DateTime?
  punchOutAt         DateTime?
  punchInLatitude    Decimal?
  punchInLongitude   Decimal?
  punchInAddress     String?
  punchInAccuracy    Float?
  punchOutLatitude   Decimal?
  punchOutLongitude  Decimal?
  punchOutAddress    String?
  punchOutAccuracy   Float?
  punchInSelfieUrl   String?
  punchOutSelfieUrl  String?
  workedSeconds      Int              @default(0)
  workedMinutes      Int              @default(0)
  lateMinutes        Int              @default(0)
  earlyExitMinutes   Int              @default(0)
  overtimeMinutes    Int              @default(0)
  status             AttendanceStatus @default(NOT_PUNCHED_IN)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  employee           Employee?        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id])

  @@unique([employeeId, attendanceDate])
  @@index([companyId])
  @@index([userId])
  @@index([employeeId])
  @@index([attendanceDate])
}

enum AttendanceStatus {
  NOT_PUNCHED_IN
  PUNCHED_IN
  PRESENT
  HALF_DAY
  ABSENT
  PAID_LEAVE
  UNPAID_LEAVE
  WEEKLY_OFF
  HOLIDAY
  MISSING_PUNCH_OUT
}

enum StockHistoryEvent {
  STOCK_IN
  RESERVE
  UNRESERVE
  DISPATCH_OUT
  QC_RECEIPT
  ADJUSTMENT
  RETURN_IN
}

model StockHistory {
  id               String            @id @default(uuid())
  companyId        String
  productId        String
  quantity         Decimal           @db.Decimal(18, 3)
  salesOrderId     String?
  salesOrderItemId String?
  allocationId     String?
  dispatchId       String?
  event            StockHistoryEvent
  actor            String?
  createdAt        DateTime          @default(now())

  @@index([companyId, productId, createdAt])
  @@index([salesOrderId])
  @@index([allocationId])
  @@index([dispatchId])
}




