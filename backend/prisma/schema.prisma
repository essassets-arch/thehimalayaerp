model Quotation {
  id              String    @id @default(uuid())
  quotationNumber String    @unique
  companyId       String?
  nextReminder    DateTime?
  workflowStateId String?
  leadId          String?
  customerId      String?
  validUntil      DateTime?
  subtotal Decimal @default(0) @db.Decimal(18, 2)
  discount Decimal @default(0) @db.Decimal(18, 2)
  tax      Decimal @default(0) @db.Decimal(18, 2)
  total    Decimal @default(0) @db.Decimal(18, 2)
  expectedTransportationCost Decimal @default(0) @db.Decimal(18, 2)
  remarks           String?
  paymentTerms      String?
  paymentTermDays   Int?
  version           Int     @default(1)
  parentQuotationId String?

