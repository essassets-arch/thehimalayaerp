generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// DocumentSequence: generates human-readable document numbers per type/year.
// Example: SO-2025-000123, QT-2025-000456, INV-2025-000987
model DocumentSequence {
  id            String   @id @default(uuid())
  companyId     String
  documentType  String // SO, QT, WO, INV, DISP, PAY, RET, REPL, SAMP, PROD ...
  prefix        String // SO, QT, etc.
  year          Int
  currentNumber Int      @default(0)
  updatedAt     DateTime @updatedAt

  @@unique([companyId, documentType, year])
  @@index([companyId, documentType])
}

// Legacy — kept for backward compat, superseded by DocumentSequence
model IdSequence {
  key       String   @id
  nextValue Int      @default(1)
  updatedAt DateTime @updatedAt
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  CREDIT_HOLD
}

model Company {
  id                    String                 @id @default(uuid())
  publicId              String                 @unique
  name                  String
  version               Int                    @default(1)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  createdById           String?
  updatedById           String?
  deletedAt             DateTime?
  branches              Branch[]
  customers             Customer[]
  employees             Employee[]
  inventoryTransactions InventoryTransaction[]
  leads                 Lead[]
  materialRequests      MaterialRequest[]
  products              Product[]
  purchaseIndents       PurchaseIndent[]
  suppliers             Supplier[]
  users                 User[]
  warehouses            Warehouse[]
  SampleRequest         SampleRequest[]
  PurchaseOrder         PurchaseOrder[]
  GoodsReceiptNote      GoodsReceiptNote[]
  VendorReturn          VendorReturn[]
  SupplierPayable       SupplierPayable[]
}

model Branch {
  id               String            @id @default(uuid())
  publicId         String            @unique
  name             String
  companyId        String
  version          Int               @default(1)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  createdById      String?
  updatedById      String?
  deletedAt        DateTime?
  company          Company           @relation(fields: [companyId], references: [id])
  customers        Customer[]
  materialRequests MaterialRequest[]
  warehouses       Warehouse[]
}

model Role {
  id              String           @id @default(uuid())
  publicId        String           @unique
  name            String
  code            String           @unique
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?
  updatedById     String?
  deletedAt       DateTime?
  rolePermissions RolePermission[]
  users           User[]
}

model Permission {
  id              String           @id @default(uuid())
  publicId        String           @unique
  name            String
  code            String           @unique
  version         Int              @default(1)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?
  updatedById     String?
  deletedAt       DateTime?
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model User {
  id                      String            @id @default(uuid())
  publicId                String            @unique
  email                   String            @unique
  password                String
  name                    String
  roleId                  String
  companyId               String
  isActive                Boolean           @default(true)
  version                 Int               @default(1)
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  createdById             String?
  updatedById             String?
  deletedAt               DateTime?
  employee                Employee?
  materialRequests        MaterialRequest[]
  purchaseIndents         PurchaseIndent[]
  assignedProductionPlans ProductionPlan[]  @relation("ProductionPlanAssignee")
  refreshSessions         RefreshSession[]
  company                 Company           @relation(fields: [companyId], references: [id])
  role                    Role              @relation(fields: [roleId], references: [id])
}

model RefreshSession {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Customer {
  id              String            @id @default(uuid())
  customerCode    String            @unique @default(uuid())
  companyId       String
  version         Int               @default(1)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdById     String?
  updatedById     String?
  deletedAt       DateTime?
  alternatePhone  String?
  billingAddress  Json?
  branchId        String?
  companyName     String
  contactPerson   String?
  creditLimit     Decimal?          @db.Decimal(14, 2)
  creditDays      Int?
  email           String?
  gstin           String?
  status          CustomerStatus    @default(ACTIVE)
  notes           String?
  pan             String?
  paymentTerms    Int?
  creditStatus    String            @default("GOOD") // GOOD, HOLD, BLOCKED
  phone           String?
  shippingAddress Json?
  branch          Branch?           @relation(fields: [branchId], references: [id])
  company         Company           @relation(fields: [companyId], references: [id])
  salesOrders     SalesOrder[]
  sampleRequests  SampleRequest[]
  payments        CustomerPayment[]
  ledgers         CustomerLedger[]

  @@unique([companyId, gstin])
  @@index([companyId, status])
  @@index([companyId, companyName])
  @@index([companyId, email])
  @@index([companyId, phone])
  @@index([companyId, gstin])
}

model Lead {
  id         String @id @default(uuid())
  leadNumber String @unique

  companyName   String
  groupName     String?
  projectName   String?
  contactPerson String
  email         String?
  phone         String?
  gstName       String?
  gstNumber     String?
  address       Json?

  source            LeadSource?
  productInterest   String?
  detailedItems     Json?
  estimatedQuantity Decimal?    @db.Decimal(18, 3)
  unit              String?

  workflowStateId String?
  workflowState   WorkflowState? @relation(fields: [workflowStateId], references: [id])

  assignedToId String?
  customerId   String?

  convertedCustomerId String?
  convertedAt         DateTime?
  convertedById       String?

  nextReminderAt DateTime?
  lostReason     String?
  remarks        String?

  version Int @default(1)

  createdById String
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  companyId      String?
  Company        Company?        @relation(fields: [companyId], references: [id])
  sampleRequests SampleRequest[]
  quotations     Quotation[]
  activities     LeadActivity[]
  followUps      FollowUp[]

  @@index([workflowStateId])
  @@index([assignedToId])
  @@index([companyName])
  @@index([email])
  @@index([phone])
  @@index([createdAt])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  companyId   String?
  branchId    String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  requestId   String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
}

model IdempotencyRecord {
  id             String   @id @default(uuid())
  userId         String
  route          String
  key            String
  requestHash    String
  responseStatus Int
  responseBody   Json
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@unique([userId, key])
}

model Product {
  id                      String                   @id @default(uuid())
  publicId                String                   @unique
  companyId               String
  name                    String
  sku                     String?
  description             String?
  category                String?
  unit                    String
  unitPrice               Decimal                  @db.Decimal(14, 2)
  isActive                Boolean                  @default(true)
  version                 Int                      @default(1)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  inventoryTransactions   InventoryTransaction[]
  materialRequestItems    MaterialRequestItem[]
  company                 Company                  @relation(fields: [companyId], references: [id])
  purchaseIndentItems     PurchaseIndentItem[]
  salesOrderItems         SalesOrderItem[]
  quotationItems          QuotationItem[]
  salesReturnItems        SalesReturnItem[]
  replacementRequestItems ReplacementRequestItem[]
  replacementOrderItems   ReplacementOrderItem[]
  SampleItem              SampleItem[]
  PurchaseOrderItem       PurchaseOrderItem[]
  GoodsReceiptNoteItem    GoodsReceiptNoteItem[]
  VendorReturnItem        VendorReturnItem[]
}

model Warehouse {
  id                    String                 @id @default(uuid())
  companyId             String
  branchId              String?
  name                  String
  location              String?
  inventoryTransactions InventoryTransaction[]
  branch                Branch?                @relation(fields: [branchId], references: [id])
  company               Company                @relation(fields: [companyId], references: [id])
  GoodsReceiptNote      GoodsReceiptNote[]
}

model InventoryTransaction {
  id            String    @id @default(uuid())
  companyId     String
  productId     String
  warehouseId   String
  type          String
  quantity      Decimal   @db.Decimal(14, 2)
  referenceId   String?
  referenceType String?
  createdAt     DateTime  @default(now())
  company       Company   @relation(fields: [companyId], references: [id])
  product       Product   @relation(fields: [productId], references: [id])
  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
}

model Supplier {
  id              String            @id @default(uuid())
  publicId        String            @unique
  companyId       String
  name            String
  contact         String?
  email           String?
  phone           String?
  gstin           String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  company         Company           @relation(fields: [companyId], references: [id])
  PurchaseOrder   PurchaseOrder[]
  VendorReturn    VendorReturn[]
  SupplierPayable SupplierPayable[]
}

model MaterialRequest {
  id            String                @id @default(uuid())
  publicId      String                @unique
  companyId     String
  branchId      String?
  requestedById String
  requestDate   DateTime              @default(now())
  status        String
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  branch        Branch?               @relation(fields: [branchId], references: [id])
  company       Company               @relation(fields: [companyId], references: [id])
  requestedBy   User                  @relation(fields: [requestedById], references: [id])
  items         MaterialRequestItem[]
}

model MaterialRequestItem {
  id                String          @id @default(uuid())
  materialRequestId String
  productId         String
  quantity          Decimal         @db.Decimal(14, 2)
  status            String
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)
  product           Product         @relation(fields: [productId], references: [id])
}

model PurchaseIndent {
  id            String               @id @default(uuid())
  publicId      String               @unique
  companyId     String
  requestedById String
  indentDate    DateTime             @default(now())
  status        String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  company       Company              @relation(fields: [companyId], references: [id])
  requestedBy   User                 @relation(fields: [requestedById], references: [id])
  items         PurchaseIndentItem[]
}

model PurchaseIndentItem {
  id                String         @id @default(uuid())
  purchaseIndentId  String
  productId         String
  quantity          Decimal        @db.Decimal(14, 2)
  materialReqItemId String?
  product           Product        @relation(fields: [productId], references: [id])
  purchaseIndent    PurchaseIndent @relation(fields: [purchaseIndentId], references: [id], onDelete: Cascade)
}

model Employee {
  id          String       @id @default(uuid())
  publicId    String       @unique
  companyId   String
  userId      String?      @unique
  firstName   String
  lastName    String
  email       String?
  phone       String?
  hireDate    DateTime
  department  String?
  jobTitle    String?
  baseSalary  Decimal      @db.Decimal(14, 2)
  status      String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  company     Company      @relation(fields: [companyId], references: [id])
  user        User?        @relation(fields: [userId], references: [id])
  salarySlips SalarySlip[]
}

model SalarySlip {
  id         String   @id @default(uuid())
  publicId   String   @unique
  employeeId String
  month      Int
  year       Int
  basePay    Decimal  @db.Decimal(14, 2)
  allowances Decimal  @db.Decimal(14, 2)
  deductions Decimal  @db.Decimal(14, 2)
  netPay     Decimal  @db.Decimal(14, 2)
  status     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model Quotation {
  id              String    @id @default(uuid())
  quotationNumber String    @unique
  companyId       String?
  workflowStateId String?
  leadId          String?
  customerId      String?
  validUntil      DateTime?

  subtotal Decimal @default(0) @db.Decimal(18, 2)
  discount Decimal @default(0) @db.Decimal(18, 2)
  tax      Decimal @default(0) @db.Decimal(18, 2)
  total    Decimal @default(0) @db.Decimal(18, 2)

  remarks           String?
  version           Int     @default(1)
  parentQuotationId String?

  createdById  String?
  approvedById String?
  approvedAt   DateTime?
  updatedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  lead              Lead?           @relation(fields: [leadId], references: [id])
  parentQuotation   Quotation?      @relation("QuotationVersions", fields: [parentQuotationId], references: [id])
  childQuotations   Quotation[]     @relation("QuotationVersions")
  workflowState     WorkflowState?  @relation(fields: [workflowStateId], references: [id])
  salesOrder        SalesOrder?     @relation("SalesOrderQuotation")
  sourceSalesOrders SalesOrder[]    @relation("SalesOrderSourceQuotation")
  items             QuotationItem[]

  @@index([workflowStateId])
  @@index([leadId])
  @@index([customerId])
  @@index([parentQuotationId])
}

model QuotationItem {
  id          String    @id @default(uuid())
  quotationId String
  productId   String
  description String?
  quantity    Decimal   @db.Decimal(18, 3)
  unitPrice   Decimal   @db.Decimal(18, 2)
  discount    Decimal   @default(0) @db.Decimal(18, 2)
  tax         Decimal   @default(0) @db.Decimal(18, 2)
  lineTotal   Decimal   @db.Decimal(18, 2)
  createdAt   DateTime  @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id])
}

model SalesOrder {
  id                           String           @id @default(uuid())
  orderNumber                  String           @unique
  customerId                   String
  quotationId                  String?          @unique
  sourceQuotationId            String?
  quotation                    Quotation?       @relation("SalesOrderQuotation", fields: [quotationId], references: [id])
  sourceQuotation              Quotation?       @relation("SalesOrderSourceQuotation", fields: [sourceQuotationId], references: [id])
  customerPurchaseOrderNo      String?
  customerPurchaseOrderDate    DateTime?
  customerPurchaseOrderFileUrl String?
  orderDate                    DateTime         @default(now())
  requestedDeliveryDate        DateTime?
  confirmedAt                  DateTime?
  subtotal                     Decimal          @db.Decimal(18, 2)
  discountAmount               Decimal          @default(0) @db.Decimal(18, 2)
  taxableAmount                Decimal          @db.Decimal(18, 2)
  taxAmount                    Decimal          @default(0) @db.Decimal(18, 2)
  freightAmount                Decimal          @default(0) @db.Decimal(18, 2)
  totalAmount                  Decimal          @db.Decimal(18, 2)
  currency                     String           @default("INR")
  paymentTermsDays             Int?
  deliveryTerms                String?
  billingAddress               Json?
  shippingAddress              Json?
  remarks                      String?
  workflowStateId              String?
  workflowState                WorkflowState?   @relation(fields: [workflowStateId], references: [id])
  status                       SalesOrderStatus @default(DRAFT)
  version                      Int              @default(1)
  createdById                  String
  updatedById                  String?
  createdAt                    DateTime         @default(now())
  updatedAt                    DateTime         @updatedAt
  deletedAt                    DateTime?

  // Relations — statuses are computed from child documents, not stored
  customer            Customer                    @relation(fields: [customerId], references: [id])
  items               SalesOrderItem[]
  productionPlans     ProductionPlan[]
  dispatches          Dispatch[]
  invoices            SalesInvoice[]
  returns             SalesReturn[]
  replacementRequests ReplacementRequest[]
  replacementOrders   ReplacementOrder[]
  amendments          OrderAmendment[]
  creditReviews       SalesOrderCreditReview[]
  allocations         SalesOrderAllocation[]
  histories           SalesOrderHistory[]
  customerPayments    CustomerPayment[]
  // Kept for backward-compat during migration; to be deprecated
  paymentAllocations  CustomerPaymentAllocation[]

  @@index([customerId])
  @@index([status])
  @@index([workflowStateId])
  @@index([createdAt])
}

model SalesOrderItem {
  id                      String                   @id @default(uuid())
  salesOrderId            String
  productId               String
  productNameSnapshot     String
  productCodeSnapshot     String?
  specifications          Json?
  orderedQuantity         Decimal                  @db.Decimal(18, 3)
  unit                    String
  unitPrice               Decimal                  @db.Decimal(18, 2)
  discountAmount          Decimal                  @default(0) @db.Decimal(18, 2)
  taxableAmount           Decimal                  @db.Decimal(18, 2)
  taxRate                 Decimal                  @default(0) @db.Decimal(8, 3)
  taxAmount               Decimal                  @default(0) @db.Decimal(18, 2)
  lineTotal               Decimal                  @db.Decimal(18, 2)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  product                 Product                  @relation(fields: [productId], references: [id])
  salesOrder              SalesOrder               @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  replacementRequestItems ReplacementRequestItem[]
  dispatchItems           DispatchItem[]
  invoiceItems            InvoiceItem[]
  workOrders              WorkOrder[]

  @@index([salesOrderId])
  @@index([productId])
}

model SalesOrderCreditReview {
  id                  String             @id @default(uuid())
  salesOrderId        String
  outstandingAmount   Decimal            @db.Decimal(18, 2)
  approvedCreditLimit Decimal            @db.Decimal(18, 2)
  availableCredit     Decimal            @db.Decimal(18, 2)
  paymentTermsDays    Int?
  result              CreditReviewResult
  reviewedById        String?
  approvedById        String?
  approvalRemarks     String?
  reviewedAt          DateTime           @default(now())
  approvedAt          DateTime?
  salesOrder          SalesOrder         @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
}

model SalesOrderAllocation {
  id                 String              @id @default(uuid())
  salesOrderId       String
  salesOrderItemId   String
  allocationType     SalesAllocationType
  requiredQuantity   Decimal             @db.Decimal(18, 3)
  reservedQuantity   Decimal             @default(0) @db.Decimal(18, 3)
  productionQuantity Decimal             @default(0) @db.Decimal(18, 3)
  workOrderId        String?
  inventoryBatchId   String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  salesOrder         SalesOrder          @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@index([salesOrderItemId])
}

model CustomerComplaint {
  id                   String                  @id @default(uuid())
  complaintNumber      String                  @unique
  customerId           String
  salesOrderId         String
  invoiceId            String?
  complaintType        CustomerComplaintType
  description          String
  evidence             Json?
  complaintStatus      CustomerComplaintStatus
  raisedById           String
  assignedToId         String?
  raisedAt             DateTime                @default(now())
  resolvedAt           DateTime?
  replacementRequestId String?
  replacementRequest   ReplacementRequest?     @relation(fields: [replacementRequestId], references: [id])
  returnRequest        SalesReturn?

  @@index([customerId])
  @@index([salesOrderId])
  @@index([complaintStatus])
}

model SalesReturn {
  id              String               @id @default(uuid())
  returnNumber    String               @unique
  rmaNumber       String               @unique
  salesOrderId    String
  complaintId     String?              @unique
  reasonCode      ReturnReasonCode
  customerRemarks String?
  internalRemarks String?
  pickupRequired  Boolean              @default(true)
  pickupAddress   Json?
  resolutionType  ReturnResolutionType
  status          ReturnStatus         @default(REQUESTED)
  dispatchDetails Json?
  deliveryProof   Json?
  workflowStateId String?
  workflowState   WorkflowState?       @relation(fields: [workflowStateId], references: [id])
  requestedById   String
  reviewedById    String?
  approvedById    String?
  requestedAt     DateTime             @default(now())
  reviewedAt      DateTime?
  approvedAt      DateTime?
  receivedAt      DateTime?
  closedAt        DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  creditNotes     CreditNote[]
  gateEntries     ReturnGateEntry[]
  inspections     ReturnQcInspection[]
  complaint       CustomerComplaint?   @relation(fields: [complaintId], references: [id])
  salesOrder      SalesOrder           @relation(fields: [salesOrderId], references: [id])
  items           SalesReturnItem[]

  @@index([salesOrderId])
  @@index([workflowStateId])
}

model SalesReturnItem {
  id                    String      @id @default(uuid())
  salesReturnId         String
  salesOrderItemId      String
  productId             String
  deliveredQuantity     Decimal     @db.Decimal(18, 3)
  previouslyReturnedQty Decimal     @default(0) @db.Decimal(18, 3)
  requestedQuantity     Decimal     @db.Decimal(18, 3)
  approvedQuantity      Decimal     @default(0) @db.Decimal(18, 3)
  receivedQuantity      Decimal     @default(0) @db.Decimal(18, 3)
  goodQuantity          Decimal     @default(0) @db.Decimal(18, 3)
  defectiveQuantity     Decimal     @default(0) @db.Decimal(18, 3)
  scrapQuantity         Decimal     @default(0) @db.Decimal(18, 3)
  reworkQuantity        Decimal     @default(0) @db.Decimal(18, 3)
  conditionReported     String?
  reason                String
  evidence              Json?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  product               Product     @relation(fields: [productId], references: [id])
  salesReturn           SalesReturn @relation(fields: [salesReturnId], references: [id], onDelete: Cascade)

  @@index([salesReturnId])
  @@index([salesOrderItemId])
}

model ReturnQcInspection {
  id                 String                   @id @default(uuid())
  salesReturnId      String
  inspectorId        String
  inspectionResult   ReturnInspectionResult
  inspectionNotes    String?
  inspectionEvidence Json?
  inspectedAt        DateTime                 @default(now())
  salesReturn        SalesReturn              @relation(fields: [salesReturnId], references: [id])
  itemResults        ReturnQcInspectionItem[]

  @@index([salesReturnId])
}

model ReturnQcInspectionItem {
  id                   String             @id @default(uuid())
  returnQcInspectionId String
  createdAt            DateTime           @default(now())
  returnQcInspection   ReturnQcInspection @relation(fields: [returnQcInspectionId], references: [id], onDelete: Cascade)
}

model ReplacementRequest {
  id                String                   @id @default(uuid())
  requestNumber     String                   @unique
  complaintId       String?                  @unique
  salesOrderId      String
  returnId          String?
  workflowStateId   String?
  workflowState     WorkflowState?           @relation(fields: [workflowStateId], references: [id])
  reasonCode        ReplacementReasonCode
  status            ReplacementRequestStatus @default(REQUESTED)
  dispatchStatus    ReplacementOrderStatus?
  dispatchDetails   Json?
  deliveryProof     Json?
  completedAt       DateTime?
  customerRemarks   String?
  internalRemarks   String?
  evidence          Json?
  requestedById     String
  reviewedById      String?
  approvedById      String?
  requestedAt       DateTime                 @default(now())
  reviewedAt        DateTime?
  approvedAt        DateTime?
  rejectedAt        DateTime?
  CustomerComplaint CustomerComplaint[]
  salesOrder        SalesOrder               @relation(fields: [salesOrderId], references: [id])
  replacementOrder  ReplacementOrder?
  items             ReplacementRequestItem[]

  @@index([salesOrderId])
  @@index([workflowStateId])
}

model ReplacementRequestItem {
  id                   String             @id @default(uuid())
  replacementRequestId String
  salesOrderItemId     String
  productId            String
  requestedQuantity    Decimal            @db.Decimal(18, 3)
  reason               String
  evidence             Json?
  createdAt            DateTime           @default(now())
  product              Product            @relation(fields: [productId], references: [id])
  salesOrderItem       SalesOrderItem     @relation(fields: [salesOrderItemId], references: [id])
  replacementRequest   ReplacementRequest @relation(fields: [replacementRequestId], references: [id], onDelete: Cascade)
}

model ReplacementOrder {
  id                   String                    @id @default(uuid())
  replacementOrderNo   String                    @unique
  originalSalesOrderId String
  replacementRequestId String                    @unique
  commercialValue      Decimal                   @default(0) @db.Decimal(18, 2)
  workflowStateId      String?
  workflowState        WorkflowState?            @relation(fields: [workflowStateId], references: [id])
  // Statuses are computed from child ProductionPlan, Dispatch, QCInspection documents
  status               ReplacementOrderStatus    @default(ORDER_CREATED)
  deliveryAddress      Json?
  remarks              String?
  createdById          String
  approvedById         String?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt
  deliveredAt          DateTime?
  closedAt             DateTime?
