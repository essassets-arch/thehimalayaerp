// A delivery is the physical receipt event. Its accepted quantities are posted
// through its GRN; documents use the existing generic Attachment table.
model ProcurementDelivery {
  id                             String                          @id @default(uuid())
  deliveryNumber                 String                          @unique
  companyId                      String
  purchaseOrderId                String
  supplierId                     String
  warehouseId                    String
  grnId                          String?                         @unique
  status                         ProcurementDeliveryStatus       @default(PENDING_VERIFICATION)
  expectedDeliveryDate           DateTime?
  actualDeliveryDate             DateTime?
  verifiedAt                     DateTime?
  verifiedById                   String?
  invoiceNumber                  String?
  deliveryChallanNo              String?
  remarks                        String?
  deletedAt                      DateTime?
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  company                        Company                         @relation(fields: [companyId], references: [id])
  purchaseOrder                  PurchaseOrder                   @relation(fields: [purchaseOrderId], references: [id])
  supplier                       Supplier                        @relation(fields: [supplierId], references: [id])
  warehouse                      Warehouse                       @relation(fields: [warehouseId], references: [id])
  grn                            GoodsReceiptNote?               @relation(fields: [grnId], references: [id])
  items                          ProcurementDeliveryItem[]
  materialRejections             MaterialRejection[]
  procurementReplacementRequests ProcurementReplacementRequest[]
  replacementDeliveryFor         ProcurementReplacementRequest[] @relation("ReplacementDelivery")

  @@index([companyId, status])
  @@index([purchaseOrderId, actualDeliveryDate])
  @@index([supplierId])
}

model ProcurementDeliveryItem {
  id                  String              @id @default(uuid())
  deliveryId          String
  purchaseOrderItemId String
  productId           String
  deliveredQuantity   Decimal             @db.Decimal(14, 2)
  acceptedQuantity    Decimal             @default(0) @db.Decimal(14, 2)
  rejectedQuantity    Decimal             @default(0) @db.Decimal(14, 2)
  remainingQuantity   Decimal             @db.Decimal(14, 2)
  remarks             String?
  createdAt           DateTime            @default(now())
  delivery            ProcurementDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem   @relation(fields: [purchaseOrderItemId], references: [id])
  product             Product             @relation(fields: [productId], references: [id])

  @@unique([deliveryId, purchaseOrderItemId])
  @@index([productId])
}

model MaterialRejection {
  id                     String                          @id @default(uuid())
  rejectionNumber        String                          @unique
  companyId              String
  purchaseOrderId        String
  supplierId             String
  deliveryId             String?
  invoiceNumber          String?
  status                 MaterialRejectionStatus         @default(SUBMITTED)
  financeRemarks         String?
  expectedResolutionDate DateTime?
  resolvedAt             DateTime?
  resolutionType         RejectionResolutionType?
  createdById            String?
  decidedById            String?
  deletedAt              DateTime?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  company                Company                         @relation(fields: [companyId], references: [id])
  purchaseOrder          PurchaseOrder                   @relation(fields: [purchaseOrderId], references: [id])
  supplier               Supplier                        @relation(fields: [supplierId], references: [id])
  delivery               ProcurementDelivery?            @relation(fields: [deliveryId], references: [id])
  items                  MaterialRejectionItem[]
  replacementRequests    ProcurementReplacementRequest[]

  @@index([companyId, status])
  @@index([purchaseOrderId])
  @@index([deliveryId])
}

model MaterialRejectionItem {
  id                  String                       @id @default(uuid())
  materialRejectionId String
  purchaseOrderItemId String
  productId           String
  quantity            Decimal                      @db.Decimal(14, 2)
  reason              String
  remarks             String?
  createdAt           DateTime                     @default(now())
  materialRejection   MaterialRejection            @relation(fields: [materialRejectionId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem            @relation(fields: [purchaseOrderItemId], references: [id])
  product             Product                      @relation(fields: [productId], references: [id])
  replacementItems    ProcurementReplacementItem[]

  @@index([productId])
}

// Named to avoid colliding with the existing sales replacement workflow.
model ProcurementReplacementRequest {
  id                    String                       @id @default(uuid())
  requestNumber         String                       @unique
  companyId             String
  purchaseOrderId       String
  supplierId            String
  deliveryId            String?
  replacementDeliveryId String?
  materialRejectionId   String?
  invoiceNumber         String?
  status                ProcurementReplacementStatus @default(PENDING_FINANCE)
  expectedDeliveryDate  DateTime?
  financeRemarks        String?
  completedAt           DateTime?
  createdById           String?
  decidedById           String?
  deletedAt             DateTime?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  company               Company                      @relation(fields: [companyId], references: [id])
  purchaseOrder         PurchaseOrder                @relation(fields: [purchaseOrderId], references: [id])
  supplier              Supplier                     @relation(fields: [supplierId], references: [id])
  delivery              ProcurementDelivery?         @relation(fields: [deliveryId], references: [id])
  replacementDelivery   ProcurementDelivery?         @relation("ReplacementDelivery", fields: [replacementDeliveryId], references: [id])
  materialRejection     MaterialRejection?           @relation(fields: [materialRejectionId], references: [id])
  items                 ProcurementReplacementItem[]

  @@index([companyId, status])
  @@index([purchaseOrderId])
  @@index([materialRejectionId])
  @@index([replacementDeliveryId])
}

model ProcurementReplacementItem {
  id                      String                        @id @default(uuid())
  replacementRequestId    String
  purchaseOrderItemId     String
  materialRejectionItemId String?
  productId               String
  quantity                Decimal                       @db.Decimal(14, 2)
  reason                  String
  remarks                 String?
  createdAt               DateTime                      @default(now())
  replacementRequest      ProcurementReplacementRequest @relation(fields: [replacementRequestId], references: [id], onDelete: Cascade)
  purchaseOrderItem       PurchaseOrderItem             @relation(fields: [purchaseOrderItemId], references: [id])
  materialRejectionItem   MaterialRejectionItem?        @relation(fields: [materialRejectionItemId], references: [id])
  product                 Product                       @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([materialRejectionItemId])
}

model ProductSupplier {
