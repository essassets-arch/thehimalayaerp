{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build && tsc -p tsconfig.seed.json",
    "build:seed": "tsc -p tsconfig.seed.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:e2e:security": "jest --config ./test/jest-e2e.json test/security.e2e-spec.ts",
    "test:e2e:procurement": "jest --config ./test/jest-e2e.json test/procurement.e2e-spec.ts",
    "test:e2e:sales": "jest --config ./test/jest-e2e.json test/sales.e2e-spec.ts",
    "test:e2e:production": "jest --config ./test/jest-e2e.json test/production.e2e-spec.ts",
    "test:e2e:qc": "jest --config ./test/jest-e2e.json test/qc.e2e-spec.ts",
    "test:e2e:dispatch": "jest --config ./test/jest-e2e.json test/dispatch.e2e-spec.ts",
    "test:e2e:finance": "jest --config ./test/jest-e2e.json test/finance.e2e-spec.ts",
    "test:e2e:payroll": "jest --config ./test/jest-e2e.json test/payroll.e2e-spec.ts",
    "test:e2e:recruitment": "jest --config ./test/jest-e2e.json test/recruitment.e2e-spec.ts",
    "test:e2e:returns": "jest --config ./test/jest-e2e.json test/after-sales.e2e-spec.ts",
    "test:e2e:replacements": "jest --config ./test/jest-e2e.json test/after-sales.e2e-spec.ts",
    "test:e2e:brand-analysis": "jest --config ./test/jest-e2e.json test/brand-analysis.e2e-spec.ts",
    "test:e2e:business": "jest --config ./test/jest-e2e.json --testPathIgnorePatterns=security.e2e-spec.ts",
    "test:e2e:all": "jest --config ./test/jest-e2e.json",
    "test:lifecycle": "ts-node scripts/test-crm-sales-lifecycle.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "db:reset:browser-test": "node scripts/reset-browser-test-db.js",
    "seed:browser-test": "ts-node prisma/seed-browser-test.ts",
    "validate:browser-test-seed": "ts-node scripts/validate-browser-test-seed.ts",
    "ensure:browser-test-credentials": "ts-node scripts/ensure-browser-test-credentials.ts",
    "http:login-preflight": "ts-node scripts/http-login-preflight.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "^2.1.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/platform-socket.io": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.2.1",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "firebase-admin": "^13.1.0",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "ts-node": "^10.9.2",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "@types/uuid": "^11.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "multer": "^2.3.0",
    "prettier": "^3.4.2",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "prisma": {
    "seed": "node dist-seed/prisma/seed.js"
  }
}
